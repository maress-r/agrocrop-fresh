---
import Logo from './Logo.astro';
import { getDictionary, localePath, type Locale } from '../i18n';
import { site } from '../config/site';

interface Props {
  locale: Locale; 
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const home = localePath(locale);
const year = new Date().getFullYear();

const links = [
  { href: `${home}#story`, label: t.nav.story },
  { href: `${home}#production`, label: t.nav.production },
  { href: `${home}#products`, label: t.nav.products },
  { href: `${home}#quality`, label: t.nav.quality },
  { href: `${home}#logistics`, label: t.nav.logistics },
  { href: `${home}#gallery`, label: t.nav.gallery },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<footer class="bg-forest-950 text-cream-50">
  <div class="container-site">
    <div class="grid gap-14 border-b rule-dark py-16 md:py-20 lg:grid-cols-[1.4fr_1fr_1.2fr] lg:gap-10">
      <!-- Brand -->
      <div class="flex max-w-sm flex-col gap-6">
        <a href={home || '/'} class="text-[1.1rem] text-cream-50 transition-opacity hover:opacity-85" aria-label="Agrocrop Fresh">
          <Logo />
        </a>
        <p class="text-[0.9375rem] leading-relaxed text-sage-200/90">{t.footer.tagline}</p>
        <p class="kicker tracking-[0.18em]! text-sage-300/70">GLOBALG.A.P.</p>
      </div>

      <!-- Nav -->
      <nav class="flex flex-col gap-4" aria-label="Footer">
        <h2 class="kicker mb-2 text-sage-300/70">{t.footer.navHeading}</h2>
        {
          links.map((link) => (
            <a
              href={link.href}
              class="w-fit text-[0.9375rem] text-cream-50/80 transition-colors duration-300 hover:text-cream-50"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Contact -->
      <div class="flex flex-col gap-4">
        <h2 class="kicker mb-2 text-sage-300/70">{t.footer.contactHeading}</h2>
        {
          site.contacts.map((c) => (
            <p class="text-[0.9375rem] text-cream-50/80">
              {c.name}
              <a
                href={`tel:${c.phoneHref}`}
                class="mt-0.5 block w-fit font-medium text-cream-50 transition-colors duration-300 hover:text-ember-400"
              >
                {c.phone}
              </a>
            </p>
          ))
        }
        <a
          href={`mailto:${site.email.office}`}
          class="w-fit text-[0.9375rem] font-medium text-cream-50 transition-colors duration-300 hover:text-ember-400"
        >
          {site.email.office}
        </a>
        <p class="text-[0.9375rem] leading-relaxed text-cream-50/60">
          {site.address.headquarters.street}, {site.address.headquarters.city}
          <br />
          {t.contact.productionHeading}: {site.address.production.city}
        </p>
      </div>
    </div>

    <!-- Legal -->
    <div
      class="flex flex-col gap-2 py-8 text-[0.8125rem] text-cream-50/45 md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} Agrocrop Fresh d.o.o. {t.footer.rights}</p>
      <p>MB {site.company.registrationNumber} · PIB {site.company.taxId}</p>
    </div>
  </div>
</footer>
