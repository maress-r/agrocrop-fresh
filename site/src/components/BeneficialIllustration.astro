---
/**
 * Line drawings of the beneficial organisms, seen from above in a 120-unit
 * box. Strokes carry pathLength="1" so a [data-inview] ancestor draws them
 * in (global.css); `draw-accent` shapes fade in after the lines.
 */
interface Props {
  name: 'propylea' | 'orius' | 'swirskii' | 'micromus';
  class?: string;
}

const { name, class: className } = Astro.props;

const line = (d: string, fine = false) =>
  `<path d="${d}" pathLength="1"${fine ? ' class="fine"' : ''}/>`;

// Fourteen-spotted ladybird: seven spots per wing case, mirrored.
const spots: [number, number][] = [
  [46, 54],
  [53.5, 54.5],
  [41.5, 64.5],
  [51, 65],
  [43.5, 76.5],
  [52.5, 77],
  [50, 88],
];
const ladybirdSpots = spots
  .flatMap(([x, y]): [number, number][] => [
    [x, y],
    [120 - x, y],
  ])
  .map(([x, y]) => `<rect x="${(x - 2.4).toFixed(1)}" y="${(y - 2.2).toFixed(1)}" width="4.8" height="4.4" rx="1.5"/>`)
  .join('');

const drawings: Record<Props['name'], string> = {
  propylea: [
    line('M56.5 30.5c-1.6-3.6-4.4-5.6-8-6.2'),
    line('M63.5 30.5c1.6-3.6 4.4-5.6 8-6.2'),
    line('M52.2 36.8c0-5 3.5-8.6 7.8-8.6s7.8 3.6 7.8 8.6'),
    line('M43.2 44.4C45 39 51.8 36.2 60 36.2s15 2.8 16.8 8.2'),
    line('M60 43.5c-15.6 0-26 11.4-26 26.3C34 85.7 45.6 97 60 97s26-11.3 26-27.2c0-14.9-10.4-26.3-26-26.3Z'),
    line('M60 43.5V97'),
    line('M37.6 55.6 30 52.2l-4.6 2.6'),
    line('M34.2 69.6h-8.6l-4 4.6'),
    line('M37.2 84.2l-7 5.4-1.6 6'),
    line('M82.4 55.6 90 52.2l4.6 2.6'),
    line('M85.8 69.6h8.6l4 4.6'),
    line('M82.8 84.2l7 5.4 1.6 6'),
    `<g class="draw-accent">${ladybirdSpots}</g>`,
  ].join(''),

  // Pirate bug: long antennae, pronotum, folded wings with membrane tips.
  orius: [
    line('M56.8 24.6 51 17.6l-6.6-3.6'),
    line('M63.2 24.6 69 17.6l6.6-3.6'),
    line('M55 31.6c-.4-4.6 1.8-8.6 5-8.6s5.4 4 5 8.6'),
    line('M53.6 32.2h12.8l5.2 11.4H48.4Z'),
    line('M48.4 44c-3.6 11-4.4 27.6-.6 40.6C49.5 90.5 54.2 95 60 95s10.5-4.5 12.2-10.4c3.8-13 3-29.6-.6-40.6'),
    line('M54.4 44.2 60 54l5.6-9.8'),
    line('M60 54v22'),
    line('M48.6 76.2c3.6 2.8 7.4 4 11.4 4s7.8-1.2 11.4-4'),
    line('M60 80.2v14.6'),
    line('M49 40.2 41 36.4l-4 2'),
    line('M47.2 55.6l-10 3-5.2 6'),
    line('M47.6 69.4l-10.4 7.4-3.2 9'),
    line('M71 40.2 79 36.4l4 2'),
    line('M72.8 55.6l10 3 5.2 6'),
    line('M72.4 69.4l10.4 7.4 3.2 9'),
    '<g class="draw-accent"><circle cx="54.7" cy="29.4" r="1.9"/><circle cx="65.3" cy="29.4" r="1.9"/></g>',
  ].join(''),

  // Predatory mite: pear-shaped body, mouthparts, eight legs, fine setae.
  swirskii: [
    line('M60 34c-9.4 0-16.2 9.2-18 22.4-1.8 13 .8 25.4 6.6 31.2C51.6 90.6 55.6 92 60 92s8.4-1.4 11.4-4.4c5.8-5.8 8.4-18.2 6.6-31.2C76.2 43.2 69.4 34 60 34Z'),
    line('M55.6 34.6 57 27.6h6l1.4 7'),
    line('M56.6 28.2 53.2 22.6'),
    line('M63.4 28.2 66.8 22.6'),
    line('M47.6 40.2C43.4 34 38 28.4 31.4 23.8'),
    line('M43.4 49.8 32.6 44.2l-8.6 1'),
    line('M42.2 62 31 66l-6 8'),
    line('M45 76.4l-7.6 10-1 10'),
    line('M72.4 40.2c4.2-6.2 9.6-11.8 16.2-16.4'),
    line('M76.6 49.8l10.8-5.6 8.6 1'),
    line('M77.8 62 89 66l6 8'),
    line('M75 76.4l7.6 10 1 10'),
    line('M52.4 45l-2.6-2.4M67.6 45l2.6-2.4M48.8 58.4l-3.4-.8M71.2 58.4l3.4-.8M50.4 72.8l-2.6 1.8M69.6 72.8l2.6 1.8M55.6 84.2l-1.6 2.6M64.4 84.2l1.6 2.6', true),
    line('M60 44v36', true),
  ].join(''),

  // Brown lacewing: slender body, long antennae, four net-veined wings.
  micromus: [
    line('M58 24.8C54 16 46 10.4 36.4 8.4'),
    line('M62 24.8c4-8.8 12-14.4 21.6-16.4'),
    '<circle cx="60" cy="28.4" r="3.6" pathLength="1"/>',
    '<ellipse cx="60" cy="38.4" rx="3.6" ry="5.4" pathLength="1"/>',
    line('M57.6 44.2c-.9 9.6-.4 23 1.1 32.6.3 1.8 2.3 1.8 2.6 0 1.5-9.6 2-23 1.1-32.6'),
    line('M56.8 36.4C46.8 26.4 30 22.4 20 27.2c-8.6 4.2-6.6 15 5 17.6 11 2.4 24-.4 31.8-4.8'),
    line('M63.2 36.4c10-10 26.8-14 36.8-9.2 8.6 4.2 6.6 15-5 17.6-11 2.4-24-.4-31.8-4.8'),
    line('M57 42.4c-9 3.6-24 11-30 19-5.4 7.4 1.6 12.6 10 9 9-3.8 17-14.6 20-24.4'),
    line('M63 42.4c9 3.6 24 11 30 19 5.4 7.4-1.6 12.6-10 9-9-3.8-17-14.6-20-24.4'),
    line('M55.6 38C45.6 33.4 32 31.4 21.2 33.8M49.6 39.4l-6.6 5M42 37.2l-5 7M34.2 35.4l-4.6 8.6', true),
    line('M64.4 38c10-4.6 23.6-6.6 34.4-4.2M70.4 39.4l6.6 5M78 37.2l5 7M85.8 35.4l4.6 8.6', true),
    line('M56.4 45.4 34.4 62.4M49.6 50l-3 9M42.6 54.6l-2 9.2', true),
    line('M63.6 45.4l22 17M70.4 50l3 9M77.4 54.6l2 9.2', true),
    '<g class="draw-accent"><circle cx="57.2" cy="27.4" r="1.4"/><circle cx="62.8" cy="27.4" r="1.4"/></g>',
  ].join(''),
};
---

<svg
  viewBox="0 0 120 120"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['beneficial-illustration', className]}
  aria-hidden="true"
  set:html={drawings[name]}
/>

<style>
  .beneficial-illustration :global(.fine) {
    stroke-width: 1;
    opacity: 0.55;
  }

  .beneficial-illustration :global(.draw-accent) {
    fill: var(--color-ember-400);
    stroke: none;
  }
</style>
