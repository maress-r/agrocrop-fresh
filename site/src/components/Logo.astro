---
/**
 * Brand logo — clean vector interpretation of the supplied artwork
 * (yellow babura pepper + wordmark), redrawn so it renders crisply
 * on both dark and light surfaces.
 *
 * To swap in original artwork later: replace the <svg> block with an
 * <img src=...> pointing to a transparent PNG/SVG — nothing else changes.
 */
interface Props {
  /** Wordmark inherits currentColor from the parent. */
  class?: string;
  /** Hide the wordmark, mark only (used in footer seal / favicon contexts). */
  markOnly?: boolean;
}

const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[0.55em]', className]}>
  <svg
    viewBox="0 0 64 64"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="h-[1.9em] w-auto shrink-0"
    aria-hidden="true"
  >
    <!-- stem -->
    <path
      d="M33.5 14C33.5 9 35 5.8 39.5 4.2"
      stroke="#4a6b3f"
      stroke-width="4"
      stroke-linecap="round"
    />
    <!-- body -->
    <path
      d="M32 14.5C22 11.8 12 18.5 12 32C12 44.5 18.5 56 26.5 56C29.5 56 30.6 53.8 32 53.8C33.4 53.8 34.5 56 37.5 56C45.5 56 52 44.5 52 32C52 18.5 42 11.8 32 14.5Z"
      fill="#eec83f"
    />
    <!-- sheen -->
    <path
      d="M20.5 22.5C17.8 25.6 16.6 29.6 16.9 33.8"
      stroke="#f8e27c"
      stroke-width="3.6"
      stroke-linecap="round"
      opacity="0.9"
    />
  </svg>
  {
    !markOnly && (
      <span class="font-sans text-[1.05em] leading-none tracking-[-0.01em] whitespace-nowrap">
        <span class="font-semibold">Agrocrop</span>
        <span class="font-normal"> Fresh</span>
      </span>
    )
  }
</span>
