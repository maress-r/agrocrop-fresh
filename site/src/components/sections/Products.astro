---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { getDictionary, localePath, type Locale } from '../../i18n';

import baburaVine from '../../assets/photos/babura-vine.jpg';
import baburaPlants from '../../assets/photos/babura-plants.jpg';
import siljaVine from '../../assets/photos/silja-vine.jpg';
import siljaCrates from '../../assets/photos/silja-crates.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const home = localePath(locale);

const media = {
  babura: {
    main: baburaVine,
    mainAlt:
      locale === 'sr'
        ? 'Krupna bela babura paprika na biljci'
        : 'Large white babura bell peppers on the plant',
    secondary: baburaPlants,
    secondaryAlt:
      locale === 'sr'
        ? 'Babura paprika u plasteniku pred berbu'
        : 'Babura peppers in the greenhouse before harvest',
  },
  silja: {
    main: siljaVine,
    mainAlt:
      locale === 'sr'
        ? 'Šilja paprika na biljci u plasteniku'
        : 'Šilja pointed peppers on the plant in the greenhouse',
    secondary: siljaCrates,
    secondaryAlt:
      locale === 'sr'
        ? 'Ubrana šilja paprika u gajbicama'
        : 'Harvested šilja peppers in crates',
  },
} as const;
---

<section id="products" class="section-pad bg-cream-100">
  <div class="container-site">
    <SectionHead
      number="03"
      kicker={t.products.kicker}
      title={t.products.title}
      lede={t.products.lede}
    />

    <div class="mt-16 flex flex-col gap-24 md:mt-24 md:gap-32">
      {
        t.products.items.map((product, i) => {
          const m = media[product.id as keyof typeof media];
          const flipped = i % 2 === 1;
          return (
            <article
              class:list={[
                'grid items-center gap-10 lg:grid-cols-12 lg:gap-0',
              ]}
            >
              {/* Imagery collage */}
              <div
                class:list={[
                  'relative lg:col-span-7',
                  flipped ? 'lg:order-2 lg:col-start-6' : 'lg:col-start-1',
                ]}
              >
                <figure class="overflow-hidden rounded-2xl" data-reveal>
                  <Image
                    src={m.main}
                    alt={m.mainAlt}
                    widths={[560, 900, 1400]}
                    sizes="(min-width: 1024px) 54vw, 92vw"
                    class="aspect-[16/11] w-full scale-[1.06] object-cover"
                    data-parallax="5"
                  />
                </figure>
                <figure
                  class:list={[
                    'absolute -bottom-10 hidden w-[38%] overflow-hidden rounded-xl shadow-[0_24px_60px_-24px_rgba(13,16,11,0.45)] lg:block',
                    flipped ? '-left-10' : '-right-10',
                  ]}
                  data-reveal
                  data-reveal-delay="0.2"
                >
                  <Image
                    src={m.secondary}
                    alt={m.secondaryAlt}
                    widths={[380, 640]}
                    sizes="22vw"
                    class="aspect-[4/3] w-full object-cover"
                  />
                </figure>
              </div>

              {/* Copy panel */}
              <div
                class:list={[
                  'relative z-10 lg:col-span-5 lg:row-start-1',
                  flipped
                    ? 'lg:order-1 lg:col-start-1 lg:pr-16'
                    : 'lg:col-start-8 lg:pl-16',
                ]}
              >
                <p class="kicker text-ember-600" data-reveal>
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3
                  class="mt-4 font-display text-[clamp(2.5rem,5vw,4rem)] leading-none font-[560] text-ink-900"
                  data-split
                >
                  {product.name}
                </h3>
                <p
                  class="mt-3 font-display text-[1.35rem] font-[450] text-earth-500 italic"
                  data-reveal
                >
                  {product.tagline}
                </p>
                <p class="mt-6 max-w-md text-[1.0625rem] leading-relaxed text-ink-600" data-reveal>
                  {product.description}
                </p>
                <ul class="mt-8 flex flex-col gap-3" data-reveal-group>
                  {product.traits.map((trait) => (
                    <li class="flex items-center gap-3 text-[0.9375rem] font-medium text-ink-700">
                      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-ember-500" aria-hidden="true" />
                      {trait}
                    </li>
                  ))}
                </ul>
                <div class="mt-10" data-reveal>
                  <Button href={`${home}#contact`} variant="ghost-dark">
                    {t.nav.cta}
                  </Button>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
