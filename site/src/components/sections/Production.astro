---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import ProductionScene from '../ProductionScene.astro';
import HeatChart from '../HeatChart.astro';
import { getDictionary, localePath, type Locale } from '../../i18n';

import cropPhoto from '../../assets/photos/babura-5.jpg';
import aerialPhoto from '../../assets/photos/aerial-haze-3.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const p = t.production;
const home = localePath(locale);

/*
 * One process in five steps — hydroponics → Priva → heating → nutrition →
 * people — then the scale of it all. On lg+ the steps scroll beside one
 * sticky illustration that follows the step being read (script below);
 * smaller screens give every step its own crop of the same drawing.
 */
const num = (i: number) => String(i + 1).padStart(2, '0');

/** Strip separators so counters animate the raw number. */
const rawValue = (v: string) => v.replace(/[.,\s]/g, '');

const cropAlt =
  locale === 'sr' ? 'Babura u redovima plastenika' : 'Babura along the greenhouse rows';
const aerialAlt =
  locale === 'sr' ? 'Plastenici u jutarnjem svetlu' : 'Greenhouses in the morning light';
---

<section id="production" class="section-pad overflow-x-clip bg-forest-900 text-cream-50">
  <div class="container-site">
    <SectionHead
      number="02"
      kicker={p.kicker}
      title={p.title}
      lede={p.lede}
      tone="dark"
    />

    <div class="process mt-16 md:mt-24" data-process>
      <ol class="process-steps">
        {
          p.steps.map((step, i) => (
            <li id={`production-${step.id}`} class="process-step" data-process-step={step.id}>
              <div class="process-visual">
                {step.id === 'people' ? (
                  <figure class="process-frame process-photo" data-reveal>
                    <Image
                      src={cropPhoto}
                      alt={cropAlt}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 48rem) 44vw, 92vw"
                      class="h-full w-full object-cover"
                    />
                  </figure>
                ) : (
                  <div class="process-frame" data-reveal>
                    <ProductionScene step={step.id} view={step.id} labels={p.scene} />
                  </div>
                )}
              </div>

              <div class="process-copy">
                <p class="kicker flex items-center gap-4 text-sage-300">
                  <span class="text-ember-400 tabular-nums">{num(i)}</span>
                  <span class="h-px w-8 bg-ember-400" aria-hidden="true" />
                  <span>{step.label}</span>
                </p>
                <h3 class="process-title" data-split>
                  {step.title}
                </h3>
                <div class="process-text" data-reveal>
                  {step.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                {step.id === 'heat' && (
                  <div class="mt-3" data-reveal>
                    <HeatChart labels={p.chart} />
                  </div>
                )}

                {step.id === 'people' && (
                  <a href={`${home}#quality`} class="process-link" data-reveal>
                    {p.qualityLink}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      class="h-4 w-4"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <!-- lg+: one illustration that follows the step being read -->
      <div class="process-stage">
        <div class="process-stage-sticky">
          <div
            class="process-frame process-stage-frame"
            data-process-stage
            data-step="hydro"
            data-reveal
            aria-hidden="true"
          >
            <ProductionScene step="hydro" labels={p.scene} live />
            <Image
              src={cropPhoto}
              alt=""
              widths={[640, 960, 1400]}
              sizes="(min-width: 90rem) 46rem, 52vw"
              class="process-stage-photo"
            />
          </div>

          <nav class="process-nav" aria-label={p.stepsLabel}>
            <p class="process-nav-current" aria-hidden="true">
              {
                p.steps.map((step, i) => (
                  <span data-process-current={step.id}>
                    <span class="text-ember-400">{num(i)}</span>
                    <span class="h-px w-6 bg-cream-50/25" />
                    <span>{step.label}</span>
                  </span>
                ))
              }
            </p>
            <ol class="process-nav-list">
              {
                p.steps.map((step, i) => (
                  <li>
                    <a href={`#production-${step.id}`} class="process-nav-link" data-process-link={step.id}>
                      <span class="sr-only">
                        {num(i)} {step.label}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </div>
    </div>

    <!-- Area and scale -->
    <div class="scale mt-24 md:mt-32 lg:mt-36">
      <figure class="scale-photo" data-reveal>
        <Image
          src={aerialPhoto}
          alt={aerialAlt}
          widths={[640, 1000, 1440, 2000]}
          sizes="(min-width: 90rem) 82rem, 92vw"
          class="h-full w-full object-cover"
        />
      </figure>

      <div class="scale-body">
        <h3 class="kicker flex items-center gap-4 text-sage-200">
          <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
          {p.statsTitle}
        </h3>
        <dl class="scale-stats" data-reveal-group>
          {
            p.stats.map((stat, i) => (
              <div class="scale-stat">
                <dt class="mt-3 max-w-[16rem] text-[0.9375rem] leading-snug text-sage-200/90">
                  {stat.label}
                </dt>
                <dd class="font-display text-[clamp(2.75rem,5vw,4.25rem)] leading-none font-[560]">
                  <span class="sr-only">
                    {stat.value} {stat.suffix}
                  </span>
                  <span class="stat-number" aria-hidden="true">
                    <span class="stat-number-final">{stat.value}</span>
                    <span data-counter={rawValue(stat.value)} data-counter-delay={(i * 0.09).toFixed(2)}>
                      {stat.value}
                    </span>
                  </span>
                  <span class="ml-1 text-[0.45em] font-[480] text-sage-300" aria-hidden="true">
                    {stat.suffix}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Steps (all sizes) ─────────────────────────────────────────── */

  .process-steps {
    --gap: 5rem;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .process-step {
    display: grid;
    gap: 2rem;
    scroll-margin-top: 7rem;
  }

  .process-step > * {
    min-width: 0;
  }

  .process-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .process-title {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 550;
    line-height: 1.12;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }

  .process-text {
    display: flex;
    max-width: 34rem;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-sage-200);
  }

  .process-text p:first-child {
    color: color-mix(in srgb, var(--color-cream-50) 90%, transparent);
  }

  /* Illustration frame: a quiet panel the drawing and photo share. */
  .process-frame {
    --panel: color-mix(in srgb, var(--color-forest-800) 55%, var(--color-forest-900));
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-sage-300) 16%, transparent);
    border-radius: 1.25rem;
    background: var(--panel);
    padding: clamp(0.75rem, 3%, 1.75rem);
  }

  .process-frame :global(.scene) {
    --scene-bg: var(--panel);
  }

  .process-photo {
    aspect-ratio: 4 / 3;
    padding: 0;
  }

  .process-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ember-400) 55%, transparent);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-cream-50);
    transition:
      color 0.3s var(--ease-out-quart),
      border-color 0.3s var(--ease-out-quart);
  }

  .process-link svg {
    transition: translate 0.4s var(--ease-out-quart);
  }

  @media (hover: hover) {
    .process-link:hover {
      border-color: var(--color-ember-400);
      color: var(--color-ember-400);
    }

    .process-link:hover svg {
      translate: 0.25rem 0;
    }
  }

  /* Tablet: visual and copy side by side, alternating; the visual stays
     in view while a longer step is read. */
  @media (min-width: 48rem) {
    .process-steps {
      --gap: 6.5rem;
    }

    .process-step {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 2.75rem;
    }

    .process-visual {
      position: sticky;
      top: 7.5rem;
    }

    .process-step:nth-child(even) .process-visual {
      order: 2;
    }
  }

  /* ── lg+: steps beside one sticky illustration ─────────────────── */

  .process-stage {
    display: none;
  }

  @media (min-width: 64rem) {
    .process {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    .process-steps {
      --gap: 0;
    }

    .process-step {
      display: flex;
      min-height: 72svh;
      flex-direction: column;
      justify-content: center;
      padding-block: 3rem;
    }

    /* The first step starts level with the top of the illustration. */
    .process-step:first-child {
      justify-content: flex-start;
      padding-top: 1.5rem;
    }

    .process-visual {
      display: none;
    }

    .process-stage {
      display: block;
      container-type: inline-size;
    }

    .process-stage-sticky {
      /* Never taller than the viewport below the header. */
      --w: min(100cqw, calc((100svh - 12.5rem) * 1.3));
      position: sticky;
      top: max(7.5rem, calc(50svh + 3rem - (var(--w) * 0.77 + 3.5rem) / 2));
      width: var(--w);
      margin-left: auto;
    }
  }

  .process-stage-frame :global(.scene) {
    transition:
      opacity 0.7s var(--ease-out-quart),
      visibility 0s;
  }

  .process-stage-frame :global(.process-stage-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 1.04;
    transition:
      opacity 0.8s var(--ease-out-quart),
      scale 1.2s var(--ease-out-expo);
  }

  /* Hidden once faded, so its flows stop painting under the photo. */
  .process-stage-frame[data-step='people'] :global(.scene) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.7s var(--ease-out-quart),
      visibility 0s 0.7s;
  }

  .process-stage-frame[data-step='people'] :global(.process-stage-photo) {
    opacity: 1;
    scale: 1;
  }

  .process-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .process-nav-current {
    display: grid;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .process-nav-current > span {
    display: flex;
    grid-area: 1 / 1;
    align-items: center;
    gap: 0.875rem;
    opacity: 0;
    translate: 0 0.375rem;
    transition:
      opacity 0.4s var(--ease-out-quart),
      translate 0.4s var(--ease-out-quart);
  }

  .process-nav-current > span:global(.is-current) {
    opacity: 1;
    translate: 0 0;
  }

  .process-nav-list {
    display: flex;
    gap: 0.375rem;
  }

  .process-nav-link {
    display: flex;
    width: 2rem;
    height: 1.5rem;
    align-items: center;
  }

  .process-nav-link::before {
    content: '';
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-cream-50) 18%, transparent);
    transition: background-color 0.4s var(--ease-out-quart);
  }

  .process-nav-link[data-state='done']::before {
    background: color-mix(in srgb, var(--color-ember-400) 45%, transparent);
  }

  .process-nav-link[aria-current]::before {
    background: var(--color-ember-400);
  }

  @media (hover: hover) {
    .process-nav-link:hover::before {
      background: var(--color-cream-50);
    }
  }

  /* ── Scale: every greenhouse from the air, the numbers beneath ─── */

  /* The whole frame, uncropped, so the full complex stays in view. Its
     foreground field melts into the section and carries the heading. */
  .scale-photo {
    overflow: hidden;
    border-radius: 1rem 1rem 0 0;
    aspect-ratio: 16 / 9;
    -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 85%, transparent 100%);
  }

  .scale-body {
    position: relative;
    margin-top: -5.5%;
  }

  .scale-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.75rem 2rem;
    margin-top: 2rem;
  }

  .scale-stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    border-top: 1px solid color-mix(in srgb, var(--color-sage-300) 26%, transparent);
    padding-top: 1.5rem;
  }

  /* Reserve the final width so neither the digits nor the unit shift
     while counting; digits land from the right, like an odometer. */
  .stat-number {
    display: inline-grid;
    font-variant-numeric: tabular-nums;
  }

  .stat-number > * {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .stat-number-final {
    visibility: hidden;
  }

  @media (min-width: 64rem) {
    .scale-photo {
      border-radius: 1.25rem 1.25rem 0 0;
    }

    .scale-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  /* ── lg+: the illustration follows the step being read ─────────── */
  const process = document.querySelector<HTMLElement>('[data-process]');
  const stage = process?.querySelector<HTMLElement>('[data-process-stage]');

  if (process && stage) {
    const steps = Array.from(process.querySelectorAll<HTMLElement>('[data-process-step]'));
    const links = Array.from(process.querySelectorAll<HTMLAnchorElement>('[data-process-link]'));
    const current = Array.from(process.querySelectorAll<HTMLElement>('[data-process-current]'));
    const scene = stage.querySelector<HTMLElement>('[data-scene]')!;
    const wide = window.matchMedia('(min-width: 64rem)');
    let active = -1;
    let frame = 0;

    const update = () => {
      frame = 0;
      if (!wide.matches) return;
      // A step is current once its top passes the middle of the viewport.
      const line = window.innerHeight * 0.5;
      let next = 0;
      steps.forEach((step, i) => {
        if (step.getBoundingClientRect().top <= line) next = i;
      });
      if (next === active) return;
      active = next;

      const id = steps[active]!.dataset.processStep!;
      stage.dataset.step = id;
      // The photo covers the drawing in the last step; the drawing keeps
      // its last state underneath so it can fade straight back.
      if (id !== 'people') scene.dataset.step = id;

      links.forEach((link, i) => {
        link.dataset.state = i < active ? 'done' : i === active ? 'active' : 'next';
        if (i === active) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
      current.forEach((el, i) => el.classList.toggle('is-current', i === active));
    };

    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    // Follow the scroll only while the steps are near the viewport.
    new IntersectionObserver(
      ([entry]) => {
        if (entry!.isIntersecting) {
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);
        } else {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
        }
        schedule();
      },
      { rootMargin: '25% 0px' }
    ).observe(process);

    wide.addEventListener('change', () => {
      active = -1;
      schedule();
    });
  }

  /* ── Flows in the drawings run only while they are on screen ───── */
  const playing = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => entry.target.classList.toggle('is-playing', entry.isIntersecting));
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#production [data-scene]').forEach((el) => playing.observe(el));
</script>
