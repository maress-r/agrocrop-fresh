---
import SectionHead from '../ui/SectionHead.astro';
import GlowCard from '../ui/GlowCard.astro';
import BeneficialIllustration from '../BeneficialIllustration.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const q = t.quality;

/*
 * One path in four steps — balance → beneficial organisms → biological
 * treatments → standards. A sticky rail (lg+) or a numbered spine (below)
 * follows the reading position; see the script at the bottom.
 */
const chapters = [
  { id: 'quality-balance', label: q.balance.label },
  { id: 'quality-beneficials', label: q.beneficials.label },
  { id: 'quality-treatments', label: q.treatments.label },
  { id: 'quality-standards', label: q.standards.label },
];
const step = (i: number) => String(i + 1).padStart(2, '0');

/** Latin names — the same in every language. */
const latin = {
  propylea: 'Propylea quatuordecimpunctata',
  orius: 'Orius laevigatus',
  swirskii: 'Amblyseius swirskii',
  micromus: 'Micromus angulatus',
} as const;

/** Minimal 24px stroke icons, in the site's 1.5px-stroke language. */
const icons = {
  // magnifier over a leaf
  monitoring: `<circle cx="10.5" cy="10.5" r="6.25"/><path d="m15.2 15.2 4.8 4.8"/><path d="M8 13c.3-2.9 2-4.6 5-4.8-.2 3-1.9 4.6-5 4.8Zm0 0 2.4-2.3"/>`,
  // balance
  assessment: `<path d="M12 4.5V20M8.5 20h7M5.5 7.5h13"/><path d="M5.5 7.5 3 13.2a2.5 2.5 0 0 0 5 0L5.5 7.5ZM18.5 7.5 16 13.2a2.5 2.5 0 0 0 5 0l-2.5-5.7Z"/>`,
  // drop
  treatment: `<path d="M12 3.6s5.6 6 5.6 10.1a5.6 5.6 0 0 1-11.2 0C6.4 9.6 12 3.6 12 3.6Z"/><path d="M9.5 14.2a2.6 2.6 0 0 0 2.5 2.3"/>`,
  // certificate rosette with a tick
  globalgap: `<circle cx="12" cy="9" r="5.25"/><path d="m9.8 9 1.5 1.5 2.9-2.9"/><path d="M9.6 13.4 8.2 20.6l3.8-2.1 3.8 2.1-1.4-7.2"/>`,
  // two people
  grasp: `<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5c.5-3.4 2.7-5.5 5.5-5.5s5 2.1 5.5 5.5"/><circle cx="16.8" cy="9.6" r="2.4"/><path d="M15.9 14.2c2.6-.4 4.5 1.4 4.9 4.3"/>`,
} as const;

const stepIcons = [icons.monitoring, icons.assessment, icons.treatment];

const standards = {
  globalgap: {
    href: 'https://globalgap.org/what-we-offer/solutions/ifa-fruit-and-vegetables/',
    icon: icons.globalgap,
  },
  grasp: { href: 'https://globalgap.org/what-we-offer/solutions/grasp/', icon: icons.grasp },
} as const;

const svgAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<section id="quality" class="section-pad overflow-x-clip bg-forest-800 text-cream-50">
  <div class="container-site">
    <SectionHead number="04" kicker={q.kicker} title={q.title} lede={q.lede} tone="dark" />

    <div class="quality-path mt-16 md:mt-24" data-quality-path>
      <nav class="quality-rail" aria-label={q.pathLabel}>
        <div class="quality-rail-inner">
          <span class="quality-rail-track" aria-hidden="true">
            <span class="quality-rail-fill" data-quality-fill></span>
          </span>
          <ol>
            {
              chapters.map((chapter, i) => (
                <li>
                  <a href={`#${chapter.id}`} class="quality-rail-link" data-quality-link>
                    <span class="quality-rail-dot" aria-hidden="true" />
                    <span class="quality-rail-num" aria-hidden="true">
                      {step(i)}
                    </span>
                    <span>{chapter.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>

      <div class="quality-chapters">
        <!-- 01 · Biological protection -->
        <article id={chapters[0]!.id} class="quality-chapter" aria-labelledby="quality-balance-title" data-quality-chapter>
          <span class="quality-node" aria-hidden="true">{step(0)}</span>
          <header class="quality-chapter-head">
            <p class="kicker flex items-center gap-4 text-sage-300">
              <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
              <span>{q.balance.label}</span>
            </p>
            <h3 id="quality-balance-title" class="quality-chapter-title" data-split>{q.balance.title}</h3>
          </header>

          <div class="mt-8 grid gap-10 md:mt-10 xl:grid-cols-12 xl:gap-14">
            <div class="xl:col-span-7">
              <p class="text-lede text-cream-50/90" data-reveal>{q.balance.lead}</p>
              <div id="quality-balance-more" class="quality-more" data-quality-more>
                <div>
                  <p class="pt-5 text-[1.0625rem] leading-relaxed text-sage-200">{q.balance.more}</p>
                </div>
              </div>
              <button
                type="button"
                class="quality-more-toggle"
                aria-expanded="true"
                aria-controls="quality-balance-more"
                data-quality-more-toggle
                hidden
              >
                <span class="when-closed">{q.balance.readMore}</span>
                <span class="when-open">{q.balance.readLess}</span>
                <svg {...svgAttrs} class="h-4 w-4"><path d="m6 9 6 6 6-6"></path></svg>
              </button>
            </div>
            <p class="quality-statement xl:col-span-5" data-reveal data-reveal-delay="0.12">
              {q.balance.statement}
            </p>
          </div>
        </article>

        <!-- 02 · Beneficial organisms -->
        <article id={chapters[1]!.id} class="quality-chapter" aria-labelledby="quality-beneficials-title" data-quality-chapter>
          <span class="quality-node" aria-hidden="true">{step(1)}</span>
          <header class="quality-chapter-head">
            <p class="kicker flex items-center gap-4 text-sage-300">
              <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
              <span>{q.beneficials.label}</span>
            </p>
            <h3 id="quality-beneficials-title" class="quality-chapter-title" data-split>{q.beneficials.title}</h3>
            <p class="max-w-2xl text-lede text-sage-200" data-reveal>{q.beneficials.intro}</p>
          </header>

          <ul class="beneficial-grid mt-10 md:mt-12" data-reveal-group data-inview>
            {
              q.beneficials.items.map((item, i) => (
                <li class="beneficial-card" style={`--draw-delay: ${(0.2 + i * 0.12).toFixed(2)}s`}>
                  <div class="beneficial-body">
                    <BeneficialIllustration name={item.id} class="beneficial-art" />
                    <div class="beneficial-head">
                      <h4 class="font-display text-[1.3rem] leading-tight font-[550]">{item.name}</h4>
                      <p class="mt-1.5 text-[0.8125rem] leading-snug text-sage-300 italic">{latin[item.id]}</p>
                      <p class="mt-1 text-[0.875rem] text-sage-200">{item.organism}</p>
                    </div>
                    <p class="beneficial-fact">{item.fact}</p>
                    <dl class="beneficial-target">
                      <dt class="kicker text-[0.6875rem] text-sage-300/80">{q.beneficials.targetLabel}</dt>
                      <dd class="mt-1.5 text-[0.9375rem] text-cream-50">{item.target}</dd>
                    </dl>
                  </div>
                </li>
              ))
            }
          </ul>
        </article>

        <!-- 03 · Biological treatments -->
        <article id={chapters[2]!.id} class="quality-chapter" aria-labelledby="quality-treatments-title" data-quality-chapter>
          <span class="quality-node" aria-hidden="true">{step(2)}</span>
          <header class="quality-chapter-head">
            <p class="kicker flex items-center gap-4 text-sage-300">
              <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
              <span>{q.treatments.label}</span>
            </p>
            <h3 id="quality-treatments-title" class="quality-chapter-title" data-split>{q.treatments.title}</h3>
          </header>

          <div class="mt-8 grid gap-12 md:mt-10 xl:grid-cols-12 xl:gap-14">
            <p class="text-lede text-sage-200 xl:col-span-6" data-reveal>{q.treatments.text}</p>
            <ol class="treatment-steps xl:col-span-6" data-inview>
              {
                q.treatments.steps.map((item, i) => (
                  <li class="treatment-step" style={`--i: ${i}`}>
                    <span class="treatment-icon">
                      <svg {...svgAttrs} class="h-5 w-5" set:html={stepIcons[i]} />
                    </span>
                    <div class="pt-2.5">
                      <h4 class="font-display text-[1.25rem] leading-tight font-[550]">{item.title}</h4>
                      <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-sage-200/85">{item.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>

        <!-- 04 · Standards -->
        <article id={chapters[3]!.id} class="quality-chapter" aria-labelledby="quality-standards-title" data-quality-chapter>
          <span class="quality-node" aria-hidden="true">{step(3)}</span>
          <header class="quality-chapter-head">
            <p class="kicker flex items-center gap-4 text-sage-300">
              <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
              <span>{q.standards.label}</span>
            </p>
            <h3 id="quality-standards-title" class="quality-chapter-title" data-split>{q.standards.title}</h3>
          </header>

          <div class="mt-10 grid gap-5 md:mt-12 md:grid-cols-2" data-reveal-group>
            {
              q.standards.items.map((item) => (
                <GlowCard class="p-7 md:p-9">
                  <div class="flex items-start justify-between gap-6">
                    <svg {...svgAttrs} class="h-9 w-9 text-ember-400" set:html={standards[item.id].icon} />
                    <a
                      href={standards[item.id].href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="standard-link"
                    >
                      globalgap.org
                      <svg {...svgAttrs} class="h-3.5 w-3.5">
                        <path d="M7 17 17 7M9 7h8v8" />
                      </svg>
                      <span class="sr-only">
                        ({item.name}, {t.a11y.newTab})
                      </span>
                    </a>
                  </div>
                  <h4 class="mt-8 font-display text-[1.75rem] leading-tight font-[550] md:mt-10">{item.name}</h4>
                  <p class="kicker mt-2.5 text-[0.75rem] text-sage-300">{item.subtitle}</p>
                  <p class="mt-5 mb-8 text-[0.9375rem] leading-relaxed text-sage-200">{item.text}</p>
                  <p class="mt-auto flex gap-3 border-t rule-dark pt-5 text-[0.875rem] leading-relaxed text-cream-50/85">
                    <svg {...svgAttrs} class="mt-0.5 h-4 w-4 shrink-0 text-ember-400">
                      <path d="m5 12.5 4.2 4.2L19 7" />
                    </svg>
                    {item.note}
                  </p>
                </GlowCard>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Path: rail (lg+) beside the chapters ──────────────────────── */

  .quality-path {
    display: grid;
  }

  .quality-rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .quality-path {
      grid-template-columns: 12.5rem minmax(0, 1fr);
      column-gap: 3.5rem;
    }

    .quality-rail {
      display: block;
    }
  }

  @media (min-width: 80rem) {
    .quality-path {
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: 5.5rem;
    }
  }

  .quality-rail-inner {
    position: sticky;
    top: 8.5rem;
  }

  .quality-rail-inner li {
    height: 3.25rem;
  }

  .quality-rail-link {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-sage-300) 75%, transparent);
    transition: color 0.3s var(--ease-out-quart);
  }

  .quality-rail-link:hover,
  .quality-rail-link[aria-current] {
    color: var(--color-cream-50);
  }

  .quality-rail-num {
    min-width: 1.5rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--color-sage-300) 60%, transparent);
    transition: color 0.3s var(--ease-out-quart);
  }

  .quality-rail-link[aria-current] .quality-rail-num {
    color: var(--color-ember-400);
  }

  .quality-rail-dot {
    position: relative;
    z-index: 1;
    width: 0.6875rem;
    height: 0.6875rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--color-cream-50) 30%, transparent);
    border-radius: 9999px;
    background: var(--color-forest-800);
    transition:
      background-color 0.35s var(--ease-out-quart),
      border-color 0.35s var(--ease-out-quart),
      box-shadow 0.35s var(--ease-out-quart);
  }

  .quality-rail-link[data-state='done'] .quality-rail-dot,
  .quality-rail-link[aria-current] .quality-rail-dot {
    border-color: var(--color-ember-400);
    background: var(--color-ember-400);
  }

  .quality-rail-link[aria-current] .quality-rail-dot {
    box-shadow: 0 0 0 0.3125rem color-mix(in srgb, var(--color-ember-400) 20%, transparent);
  }

  /* Line through the dot centres; the fill follows the reading position. */
  .quality-rail-track {
    position: absolute;
    top: 1.625rem;
    bottom: 1.625rem;
    left: calc(0.34375rem - 0.5px);
    width: 1px;
    background: color-mix(in srgb, var(--color-cream-50) 15%, transparent);
  }

  .quality-rail-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ember-400);
    transform: scaleY(var(--progress, 0));
    transform-origin: top;
  }

  /* ── Chapters, with a numbered spine below lg ──────────────────── */

  .quality-chapters {
    --gap: 6rem;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  @media (min-width: 48rem) {
    .quality-chapters {
      --gap: 8rem;
    }
  }

  .quality-chapter {
    position: relative;
    scroll-margin-top: 8rem;
    container: chapter / inline-size;
  }

  .quality-chapter-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quality-chapter-title {
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 550;
    line-height: 1.12;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }

  .quality-node {
    display: none;
  }

  @media (max-width: 63.999rem) {
    .quality-chapter {
      padding-left: 3.25rem;
    }

    .quality-node {
      position: absolute;
      top: -0.5rem;
      left: 0;
      z-index: 1;
      display: grid;
      width: 2.25rem;
      height: 2.25rem;
      place-items: center;
      border: 1px solid color-mix(in srgb, var(--color-cream-50) 22%, transparent);
      border-radius: 9999px;
      background: var(--color-forest-800);
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
      color: var(--color-sage-300);
      transition:
        color 0.35s var(--ease-out-quart),
        border-color 0.35s var(--ease-out-quart);
    }

    .quality-chapter[data-state='active'] .quality-node,
    .quality-chapter[data-state='done'] .quality-node {
      border-color: var(--color-ember-400);
      color: var(--color-cream-50);
    }

    .quality-chapter:not(:last-child)::before,
    .quality-chapter:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.75rem;
      bottom: calc(-1 * var(--gap) - 0.5rem);
      left: calc(1.125rem - 0.5px);
      width: 1px;
    }

    .quality-chapter:not(:last-child)::before {
      background: color-mix(in srgb, var(--color-cream-50) 14%, transparent);
    }

    .quality-chapter:not(:last-child)::after {
      background: var(--color-ember-400);
      transform: scaleY(var(--progress, 0));
      transform-origin: top;
    }
  }

  /* ── 01: the second paragraph opens on demand ──────────────────── */

  .quality-more {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.6s var(--ease-out-expo);
  }

  .quality-more > div {
    min-height: 0;
    overflow: hidden;
  }

  .quality-more > div > p {
    transition:
      opacity 0.45s var(--ease-out-quart),
      translate 0.6s var(--ease-out-expo);
  }

  .quality-more:global(.is-collapsed) {
    grid-template-rows: 0fr;
  }

  .quality-more:global(.is-collapsed) > div > p {
    opacity: 0;
    translate: 0 -0.5rem;
  }

  .quality-more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ember-400) 55%, transparent);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-cream-50);
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out-quart),
      border-color 0.3s var(--ease-out-quart);
  }

  .quality-more-toggle[hidden] {
    display: none;
  }

  .quality-more-toggle svg {
    transition: rotate 0.45s var(--ease-out-expo);
  }

  .quality-more-toggle[aria-expanded='true'] svg {
    rotate: 180deg;
  }

  .quality-more-toggle[aria-expanded='true'] .when-closed,
  .quality-more-toggle[aria-expanded='false'] .when-open {
    display: none;
  }

  @media (hover: hover) {
    .quality-more-toggle:hover {
      border-color: var(--color-ember-400);
      color: var(--color-ember-400);
    }
  }

  .quality-statement {
    align-self: start;
    border-left: 1px solid color-mix(in srgb, var(--color-ember-400) 70%, transparent);
    padding-left: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    line-height: 1.4;
    color: var(--color-cream-50);
  }

  @media (min-width: 48rem) {
    .quality-statement {
      padding-left: 2rem;
    }
  }

  /* ── 02: beneficial organisms ──────────────────────────────────── */

  .beneficial-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .beneficial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .beneficial-grid {
      gap: 1.25rem;
    }
  }

  /* Four in a row once each card has room for its name on one line. */
  @container chapter (min-width: 56rem) {
    .beneficial-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Upright card by default; drawing beside the name when the card is
     wide enough (its own width decides — see the container query). */
  .beneficial-card {
    position: relative;
    container-type: inline-size;
    border: 1px solid color-mix(in srgb, var(--color-sage-300) 26%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-forest-900) 40%, transparent);
  }

  .beneficial-body {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .beneficial-card :global(.beneficial-art) {
    width: 4.5rem;
    height: 4.5rem;
    margin: 0.25rem 0 0.25rem -0.375rem;
    color: var(--color-sage-200);
    transition:
      color 0.5s var(--ease-out-quart),
      rotate 0.7s var(--ease-out-expo),
      scale 0.7s var(--ease-out-expo);
  }

  .beneficial-fact {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-sage-200) 85%, transparent);
  }

  .beneficial-target {
    margin-top: auto;
    border-top: 1px solid color-mix(in srgb, var(--color-sage-300) 26%, transparent);
    padding-top: 1rem;
  }

  @media (min-width: 48rem) {
    .beneficial-body {
      padding: 1.5rem 1.5rem 1.75rem;
    }

    .beneficial-card :global(.beneficial-art) {
      width: 5.5rem;
      height: 5.5rem;
    }
  }

  @container (min-width: 24rem) {
    .beneficial-body {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-areas:
        'art head'
        'fact fact'
        'target target';
      gap: 1rem 1.5rem;
    }

    .beneficial-body :global(.beneficial-art) {
      grid-area: art;
      margin: 0;
    }

    .beneficial-head {
      grid-area: head;
      align-self: center;
    }

    .beneficial-fact {
      grid-area: fact;
    }

    .beneficial-target {
      grid-area: target;
      margin-top: 0;
    }
  }

  /* The drawing stirs under the pointer; the card itself is not a link. */
  @media (hover: hover) {
    .beneficial-card:hover :global(.beneficial-art) {
      color: var(--color-cream-50);
      rotate: -6deg;
      scale: 1.05;
    }
  }

  /* ── 03: the steps light up in order ───────────────────────────── */

  .treatment-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .treatment-step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1.25rem;
  }

  .treatment-step:not(:last-child)::before,
  .treatment-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 3.5rem;
    bottom: -1.5rem;
    left: calc(1.5rem - 0.5px);
    width: 1px;
  }

  .treatment-step:not(:last-child)::before {
    background: color-mix(in srgb, var(--color-cream-50) 14%, transparent);
  }

  .treatment-step:not(:last-child)::after {
    background: var(--color-ember-400);
    transform-origin: top;
    transition: transform 0.5s var(--ease-out-quart) calc(var(--i) * 0.6s + 0.1s);
  }

  .treatment-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ember-400) 60%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-ember-400) 8%, transparent);
    color: var(--color-ember-400);
    transition:
      color 0.5s var(--ease-out-quart) calc(var(--i) * 0.6s),
      border-color 0.5s var(--ease-out-quart) calc(var(--i) * 0.6s),
      background-color 0.5s var(--ease-out-quart) calc(var(--i) * 0.6s);
  }

  :global(html.has-motion) .treatment-steps:not(.is-inview) .treatment-step::after {
    transform: scaleY(0);
  }

  :global(html.has-motion) .treatment-steps:not(.is-inview) .treatment-icon {
    border-color: color-mix(in srgb, var(--color-cream-50) 18%, transparent);
    background: transparent;
    color: var(--color-sage-300);
  }

  /* ── 04: standards ─────────────────────────────────────────────── */

  .standard-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
    color: var(--color-sage-300);
    transition: color 0.3s var(--ease-out-quart);
  }

  @media (hover: hover) {
    .standard-link:hover {
      color: var(--color-cream-50);
    }
  }
</style>

<script>
  /* ── Path: rail + spine follow the reading position ───────────── */
  const path = document.querySelector<HTMLElement>('[data-quality-path]');

  if (path) {
    const chapters = Array.from(path.querySelectorAll<HTMLElement>('[data-quality-chapter]'));
    const links = Array.from(path.querySelectorAll<HTMLAnchorElement>('[data-quality-link]'));
    const fill = path.querySelector<HTMLElement>('[data-quality-fill]');
    const last = chapters.length - 1;
    let frame = 0;

    const update = () => {
      frame = 0;
      // A chapter is current once its top passes the reading line.
      const line = window.innerHeight * 0.45;
      let active = 0;
      const progress = chapters.map((chapter, i) => {
        const { top, height } = chapter.getBoundingClientRect();
        if (top <= line) active = i;
        return Math.min(1, Math.max(0, (line - top) / height));
      });

      chapters.forEach((chapter, i) => {
        const state = i < active ? 'done' : i === active ? 'active' : 'next';
        chapter.dataset.state = state;
        chapter.style.setProperty('--progress', progress[i]!.toFixed(3));
        links[i]!.dataset.state = state;
        if (i === active) links[i]!.setAttribute('aria-current', 'step');
        else links[i]!.removeAttribute('aria-current');
      });

      // Rail dots are evenly spaced: position = current step + progress in it.
      const at = Math.min(last, active + progress[active]!);
      fill?.style.setProperty('--progress', (at / last).toFixed(4));
    };

    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    // Follow the scroll only while the section is near the viewport.
    new IntersectionObserver(
      ([entry]) => {
        if (entry!.isIntersecting) {
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);
        } else {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
        }
        schedule();
      },
      { rootMargin: '25% 0px' }
    ).observe(path);
  }

  /* ── 01: "How we do it" opens the second paragraph ────────────── */
  document.querySelectorAll<HTMLButtonElement>('[data-quality-more-toggle]').forEach((button) => {
    const region = document.getElementById(button.getAttribute('aria-controls')!)!;
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      region.classList.toggle('is-collapsed', !open);
      region.inert = !open;
    };
    // Open without JS; collapsed (with its toggle shown) once the script runs.
    set(false);
    button.hidden = false;
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
  });
</script>
