---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../ui/SectionHead.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const sr = locale === 'sr';

const library = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,png}', {
  eager: true,
});
const photo = (name: string) => {
  const hit = Object.entries(library).find(([path]) => path.endsWith(`/${name}`));
  if (!hit) throw new Error(`Gallery photo not found: ${name}`);
  return hit[1].default;
};

type Entry = { src: ImageMetadata; alt: string };
const entry = (name: string, srAlt: string, enAlt: string): Entry => ({
  src: photo(name),
  alt: sr ? srAlt : enAlt,
});

/** The curated set shown on the page, in reading order. */
const photos: Entry[] = [
  entry('aerial-complex.jpg', 'Kompleks plastenika iz vazduha', 'Greenhouse complex from the air'),
  entry('babura-vine.jpg', 'Bela babura na biljci', 'White babura peppers on the plant'),
  entry('greenhouse-rows.jpg', 'Unutrašnjost plastenika sa redovima paprike', 'Greenhouse interior with rows of peppers'),
  entry('silja-crates.jpg', 'Šilja paprika u gajbicama', 'Šilja peppers in crates'),
  entry('seedling-hand.jpg', 'Rasad paprike u ruci', 'Pepper seedling in hand'),
  entry('export-babura-boxes.jpg', 'Spakovane kutije za izvoz', 'Boxes packed for export'),
  entry('babura-plants-2.jpg', 'Babura paprika pred berbu', 'Babura peppers before harvest'),
  entry('silja-2.jpg', 'Šilja paprika u zasadu', 'Šilja peppers in the crop'),
  entry('aerial-haze.jpg', 'Plastenici u jutarnjoj izmaglici', 'Greenhouses in morning haze'),
];

/** Everything else, opened from the "+" tile. */
const morePhotos: Entry[] = [
  entry('aerial-fields.jpg', 'Kompleks plastenika među oranicama, iz vazduha', 'The greenhouse complex among open fields, from the air'),
  entry('babura-4.jpg', 'Žuta babura na biljci', 'Yellow babura peppers on the plant'),
  entry('greenhouse-block.jpg', 'Prolaz kroz hidroponski plastenik', 'An aisle through the hydroponic greenhouse'),
  entry('silja-vine.jpg', 'Šilja paprika na biljci', 'Šilja peppers on the plant'),
  entry('seedling-rows.jpg', 'Mlad rasad paprike u stakleniku', 'Young pepper seedlings in the glasshouse'),
  entry('export-babura-1.jpg', 'Babura spakovana za isporuku', 'Babura peppers packed for delivery'),
  entry('aerial-haze-2.jpg', 'Redovi plastenika u svitanje', 'Rows of greenhouses at dawn'),
  entry('babura-6.jpg', 'Bela babura na grani', 'White babura peppers on the branch'),
  entry('silja-channel.jpg', 'Redovi šilje u plasteniku', 'Rows of šilja in the greenhouse'),
  entry('babura-crates.png', 'Gajbice sa ubranom baburom', 'Crates of harvested babura'),
  entry('packing-hall-2.jpg', 'Crvena i žuta paprika', 'Red and yellow peppers'),
  entry('greenhouse-setup.jpg', 'Mlade biljke paprike u plasteniku', 'Young pepper plants in the greenhouse'),
  entry('babura-3.jpg', 'Grozdovi žute babure', 'Clusters of yellow babura'),
  entry('silja-3.jpg', 'Šilja paprika izbliza', 'Šilja peppers up close'),
  entry('aerial-haze-3.jpg', 'Plastenici u jutarnjem svetlu', 'Greenhouses in the morning light'),
  entry('export-silja.jpg', 'Šilja spakovana za isporuku', 'Šilja peppers packed for delivery'),
  entry('babura-7.jpg', 'Bela babura izbliza', 'White babura peppers up close'),
  entry('greenhouse-block-2.jpg', 'Hidroponska proizvodnja paprike', 'Hydroponic pepper production'),
  entry('silja-growth.jpg', 'Šilja u punom rodu', 'Šilja plants in full crop'),
  entry('packing-silja.jpg', 'Palete sa šiljom spremne za utovar', 'Pallets of šilja ready for loading'),
  entry('babura-2.jpg', 'Babura u zasadu', 'Babura peppers in the crop'),
  entry('aerial-bw.jpg', 'Kompleks plastenika, crno-bela fotografija iz vazduha', 'The greenhouse complex, black-and-white aerial'),
  entry('export-babura-2.jpg', 'Kutija babure za izvoz', 'A box of babura for export'),
  entry('silja-growth-2.jpg', 'Šilja paprika pred berbu', 'Šilja peppers before harvest'),
  entry('babura-5.jpg', 'Babura u redovima plastenika', 'Babura along the greenhouse rows'),
  entry('packing-hall.jpg', 'Sveže ubrana crvena i žuta paprika u ruci', 'Freshly picked red and yellow peppers in hand'),
  entry('babura-plants.jpg', 'Biljke babure sa plodovima', 'Babura plants carrying fruit'),
  entry('export-babura-3.jpg', 'Babura u izvoznoj ambalaži', 'Babura in export packaging'),
];

/** Pre-render large versions for the lightbox. */
const fullSize = (e: Entry) => getImage({ src: e.src, width: 1800, format: 'webp', quality: 78 });
const [fullSizes, moreFullSizes] = await Promise.all([
  Promise.all(photos.map(fullSize)),
  Promise.all(morePhotos.map(fullSize)),
]);

/*
 * The "+" tile fills the gap the masonry leaves at the foot of its shortest
 * column. Columns are pinned with column breaks so that gap is predictable:
 *   below lg  [0–3] | [4–8]        → gap under the first column
 *   lg and up [0–2] | [3–5] | [6–8] → gap under the third column
 * Every photo keeps its proportions, so the gap is a fixed multiple of the
 * column width plus a whole number of gutters — both computed here.
 */
const ratio = (e: Entry) => e.src.height / e.src.width;
function tileFor(splits: number[], tileCol: number) {
  const cols = splits.slice(0, -1).map((start, c) => {
    const list = photos.slice(start, splits[c + 1]);
    return { r: list.reduce((acc, e) => acc + ratio(e), 0), n: list.length };
  });
  const own = cols[tileCol]!;
  const tallest = cols.filter((_, c) => c !== tileCol).reduce((a, b) => (b.r > a.r ? b : a));
  return {
    cols: cols.length,
    fill: (tallest.r - own.r).toFixed(4),
    // Gutters in the tallest column minus those above the tile in its own.
    gutters: tallest.n - 1 - own.n,
  };
}
const tiles = {
  two: { ...tileFor([0, 4, 9], 0), after: 3, only: 'lg:hidden' },
  three: { ...tileFor([0, 3, 6, 9], 2), after: 8, only: 'max-lg:hidden' },
};
const breaksBefore = (i: number) =>
  i === 4 ? 'max-lg:break-before-column' : i === 3 || i === 6 ? 'lg:break-before-column' : '';

const moreCount = t.gallery.moreCount.replace('{count}', String(morePhotos.length));
const tileClass =
  'group mb-4 block w-full cursor-zoom-in overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ember-500 md:mb-5';
---

<section id="gallery" class="section-pad bg-cream-100">
  <div class="container-site">
    <SectionHead number="06" kicker={t.gallery.kicker} title={t.gallery.title} />

    <div class="gallery-grid mt-14 columns-2 gap-4 md:mt-20 md:gap-5 lg:columns-3" data-reveal-group>
      {
        photos.map((photo, i) => (
          <>
            <button
              type="button"
              class:list={[tileClass, breaksBefore(i)]}
              data-lightbox-trigger={i}
              data-full={fullSizes[i]!.src}
              aria-label={`${t.a11y.galleryOpen}: ${photo.alt}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[420, 640, 960]}
                sizes="(min-width: 1024px) 30vw, 46vw"
                class="w-full transition-transform duration-700 ease-(--ease-out-quart) group-hover:scale-[1.045]"
              />
            </button>
            {Object.values(tiles)
              .filter((tile) => tile.after === i)
              .map((tile) => (
                <button
                  type="button"
                  class:list={[
                    'gallery-more-tile mb-4 flex w-full cursor-pointer flex-col items-center justify-center gap-4 rounded-xl text-center focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ember-500 md:mb-5',
                    tile.only,
                  ]}
                  style={`--tile-cols: ${tile.cols}; --tile-fill: ${tile.fill}; --tile-gutters: ${tile.gutters}`}
                  aria-label={`${t.gallery.more}: ${moreCount}`}
                  aria-haspopup="dialog"
                  aria-controls="gallery-more"
                  data-gallery-more-open
                >
                  <svg class="gallery-more-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M12 3v18M3 12h18" stroke-width="1.25" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                  </svg>
                  <span class="flex flex-col items-center gap-1.5">
                    <span class="kicker text-ink-700">{t.gallery.more}</span>
                    <span class="text-[0.875rem] text-ink-600">{moreCount}</span>
                  </span>
                </button>
              ))}
          </>
        ))
      }
    </div>
  </div>
</section>

<!-- More photos -->
<dialog
  id="gallery-more"
  class="gallery-more m-auto overflow-hidden rounded-2xl bg-cream-100 p-0 text-ink-900 shadow-2xl"
  aria-labelledby="gallery-more-title"
  data-lenis-prevent
>
  <div class="flex h-full flex-col">
    <header class="flex items-start justify-between gap-6 border-b rule-light px-5 py-5 md:px-10 md:py-7">
      <div class="flex flex-col gap-3">
        <p class="kicker flex items-center gap-4 text-ink-600">
          <span class="h-px w-8 bg-ember-500" aria-hidden="true"></span>
          <span>{t.gallery.kicker} · {moreCount}</span>
        </p>
        <h2 id="gallery-more-title" class="font-display text-display-md font-[550] text-balance">
          {t.gallery.moreTitle}
        </h2>
      </div>
      <button
        type="button"
        class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-ink-900/20 text-ink-900 transition-colors duration-300 hover:border-ink-900/60 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ember-500"
        aria-label={t.a11y.lightboxClose}
        data-gallery-more-close
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pt-6 pb-10 md:px-10 md:pt-8">
      <div class="columns-2 gap-4 md:gap-5 lg:columns-3">
        {
          morePhotos.map((photo, i) => (
            <button
              type="button"
              class={tileClass}
              data-lightbox-trigger={photos.length + i}
              data-full={moreFullSizes[i]!.src}
              aria-label={`${t.a11y.galleryOpen}: ${photo.alt}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[420, 640, 960]}
                sizes="(min-width: 1024px) 26vw, 44vw"
                class="w-full transition-transform duration-700 ease-(--ease-out-quart) group-hover:scale-[1.045]"
              />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<!-- Lightbox -->
<dialog
  id="lightbox"
  class="m-auto max-h-[100dvh] max-w-[100vw] bg-transparent p-0 backdrop:bg-forest-950/95"
  data-lenis-prevent
>
  <div class="flex h-dvh w-screen flex-col items-center justify-center gap-4 p-4 md:p-10">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[82dvh] max-w-full rounded-lg object-contain shadow-2xl"
    />
    <p id="lightbox-caption" class="max-w-xl text-center text-sm text-sage-200"></p>

    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:top-6 md:right-6"
      aria-label={t.a11y.lightboxClose}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-prev"
      class="absolute top-1/2 left-2 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:left-6"
      aria-label={t.a11y.lightboxPrev}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-next"
      class="absolute top-1/2 right-2 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:right-6"
      aria-label={t.a11y.lightboxNext}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</dialog>

<style>
  /* Lets the "+" tile size itself against the grid's column width.
     --g mirrors the grid's gutter (gap-4 / md:gap-5, mb-4 / md:mb-5). */
  .gallery-grid {
    container-type: inline-size;
    --g: 1rem;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      --g: 1.25rem;
    }
  }

  /* Exactly the gap under its column: fill × column width + whole gutters. */
  .gallery-more-tile {
    --col: calc((100cqw - (var(--tile-cols) - 1) * var(--g)) / var(--tile-cols));
    height: max(7rem, calc(var(--tile-fill) * var(--col) + var(--tile-gutters) * var(--g)));
    border: 1px solid color-mix(in srgb, var(--color-ink-900) 9%, transparent);
    background: var(--color-cream-200);
    color: var(--color-ink-700);
    transition:
      background-color 0.4s var(--ease-out-quart),
      border-color 0.4s var(--ease-out-quart),
      transform 0.4s var(--ease-out-quart);
  }

  .gallery-more-plus {
    width: clamp(2.5rem, 4vw, 3.5rem);
    height: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-forest-600);
    transition:
      transform 0.5s var(--ease-out-expo),
      color 0.4s var(--ease-out-quart);
  }

  @media (hover: hover) {
    .gallery-more-tile:hover {
      background: color-mix(in srgb, var(--color-forest-600) 9%, var(--color-cream-200));
      border-color: color-mix(in srgb, var(--color-forest-600) 32%, transparent);
    }

    .gallery-more-tile:hover .gallery-more-plus {
      color: var(--color-ember-600);
      transform: rotate(90deg) scale(1.08);
    }
  }

  .gallery-more-tile:active {
    transform: scale(0.985);
  }

  /* ── "More" dialog ─────────────────────────────────────────────── */

  .gallery-more {
    width: calc(100vw - 1rem);
    height: calc(100dvh - 1rem);
    max-width: none;
    max-height: none;
    opacity: 0;
    transform: translateY(0.75rem) scale(0.985);
    transition:
      opacity 0.35s var(--ease-out-quart),
      transform 0.45s var(--ease-out-expo);
  }

  .gallery-more[data-open] {
    opacity: 1;
    transform: none;
  }

  .gallery-more::backdrop {
    background: color-mix(in srgb, var(--color-forest-950) 72%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out-quart);
  }

  .gallery-more[data-open]::backdrop {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .gallery-more {
      width: min(92vw, 84rem);
      height: min(90dvh, 62rem);
    }
  }
</style>

<script>
  /* Page scroll stays locked while any gallery dialog is open; the gutter is
     kept so the page doesn't shift sideways when the scrollbar goes. */
  const root = document.documentElement;
  const anyOpen = () => !!document.querySelector('#lightbox[open], #gallery-more[open]');
  const lockScroll = () => {
    root.style.scrollbarGutter = 'stable';
    root.style.overflow = 'hidden';
  };
  const releaseScroll = () => {
    if (anyOpen()) return;
    root.style.overflow = '';
    root.style.scrollbarGutter = '';
  };

  /* ── Lightbox ─────────────────────────────────────────────────── */
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')
  );

  let index = 0;

  const show = (i: number) => {
    index = (i + triggers.length) % triggers.length;
    const trigger = triggers[index]!;
    const alt = trigger.querySelector('img')?.alt ?? '';
    img.src = trigger.dataset.full!;
    img.alt = alt;
    caption.textContent = alt;
  };

  triggers.forEach((trigger, i) => {
    trigger.addEventListener('click', () => {
      show(i);
      dialog.showModal();
      lockScroll();
    });
  });

  /* Our own close paths tidy up directly; the 'close' listener covers the
     native Escape path. Both are safe to run twice. */
  const afterLightbox = () => {
    releaseScroll();
    triggers[index]?.focus();
  };
  const close = () => {
    dialog.close();
    afterLightbox();
  };
  dialog.addEventListener('close', afterLightbox);

  document.getElementById('lightbox-close')!.addEventListener('click', close);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => show(index - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => show(index + 1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  /* Click on backdrop closes */
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  /* ── "More" dialog ────────────────────────────────────────────── */
  const more = document.getElementById('gallery-more') as HTMLDialogElement;
  // One opener per layout (only the visible one is reachable); focus goes
  // back to whichever was used.
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-gallery-more-open]');
  let opener: HTMLButtonElement | null = null;

  const openMore = (e: Event) => {
    opener = e.currentTarget as HTMLButtonElement;
    more.showModal();
    lockScroll();
    // Flush styles first so the entrance transition runs from the closed state.
    void more.offsetWidth;
    more.setAttribute('data-open', '');
  };

  const afterMore = () => {
    releaseScroll();
    opener?.focus();
  };

  let closing = false;
  const closeMore = () => {
    if (!more.open || closing) return;
    closing = true;
    more.removeAttribute('data-open');
    const done = () => {
      clearTimeout(fallback);
      more.removeEventListener('transitionend', onEnd);
      closing = false;
      more.close();
      afterMore();
    };
    const onEnd = (e: TransitionEvent) => {
      if (e.target === more && e.propertyName === 'opacity') done();
    };
    // Reduced motion shortens transitions to ~0; the timeout covers any
    // case where transitionend never fires.
    const fallback = window.setTimeout(done, 500);
    more.addEventListener('transitionend', onEnd);
  };

  openers.forEach((el) => el.addEventListener('click', openMore));
  more.querySelector('[data-gallery-more-close]')!.addEventListener('click', closeMore);

  // Escape: animate out instead of the dialog's instant close.
  more.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeMore();
  });

  more.addEventListener('click', (e) => {
    if (e.target === more) closeMore();
  });

  more.addEventListener('close', afterMore);
</script>
