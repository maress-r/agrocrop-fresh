---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../ui/SectionHead.astro';
import GalleryMasonry from '../GalleryMasonry.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const sr = locale === 'sr';

const library = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,png}', {
  eager: true,
});
const image = (file: string) => {
  const hit = Object.entries(library).find(([path]) => path.endsWith(`/${file}`));
  if (!hit) throw new Error(`Gallery photo not found: ${file}`);
  return hit[1].default;
};

/** Alt text per photo, [sr, en] — also the caption in the lightbox. */
const alts: Record<string, [string, string]> = {
  // On the page
  'babura-4.jpg': ['Žuta babura na biljci', 'Yellow babura peppers on the plant'],
  'babura-vine.jpg': ['Bela babura na biljci', 'White babura peppers on the plant'],
  'greenhouse-rows.jpg': ['Unutrašnjost plastenika sa redovima paprike', 'Greenhouse interior with rows of peppers'],
  'silja-crates.jpg': ['Šilja paprika u gajbicama', 'Šilja peppers in crates'],
  'export-babura-boxes.jpg': ['Spakovane kutije za izvoz', 'Boxes packed for export'],
  'babura-plants-2.jpg': ['Babura paprika pred berbu', 'Babura peppers before harvest'],
  'silja-2.jpg': ['Šilja paprika u zasadu', 'Šilja peppers in the crop'],
  'aerial-haze.jpg': ['Plastenici u jutarnjoj izmaglici', 'Greenhouses in morning haze'],
  'packing-hall-2.jpg': ['Crvena i žuta paprika', 'Red and yellow peppers'],
  'silja-3.jpg': ['Šilja paprika izbliza', 'Šilja peppers up close'],
  // Behind the "+" tile
  'babura-3.jpg': ['Grozdovi žute babure', 'Clusters of yellow babura'],
  'aerial-haze-2.jpg': ['Redovi plastenika u svitanje', 'Rows of greenhouses at dawn'],
  'babura-crates.png': ['Gajbice sa ubranom baburom', 'Crates of harvested babura'],
  'silja-vine.jpg': ['Šilja paprika na biljci', 'Šilja peppers on the plant'],
  'greenhouse-block.jpg': ['Prolaz kroz hidroponski plastenik', 'An aisle through the hydroponic greenhouse'],
  'silja-growth.jpg': ['Šilja u punom rodu', 'Šilja plants in full crop'],
  'export-babura-1.jpg': ['Babura spakovana za isporuku', 'Babura peppers packed for delivery'],
  'silja-growth-2.jpg': ['Šilja paprika pred berbu', 'Šilja peppers before harvest'],
  'packing-hall.jpg': ['Sveže ubrana crvena i žuta paprika u ruci', 'Freshly picked red and yellow peppers in hand'],
  'greenhouse-block-2.jpg': ['Hidroponska proizvodnja paprike', 'Hydroponic pepper production'],
  'export-babura-3.jpg': ['Babura u izvoznoj ambalaži', 'Babura in export packaging'],
  'babura-plants.jpg': ['Biljke babure sa plodovima', 'Babura plants carrying fruit'],
  'babura-2.jpg': ['Babura u zasadu', 'Babura peppers in the crop'],
  'silja-channel.jpg': ['Redovi šilje u plasteniku', 'Rows of šilja in the greenhouse'],
  'export-silja.jpg': ['Šilja spakovana za isporuku', 'Šilja peppers packed for delivery'],
  'packing-silja.jpg': ['Palete sa šiljom spremne za utovar', 'Pallets of šilja ready for loading'],
  'babura-6.jpg': ['Bela babura na grani', 'White babura peppers on the branch'],
  'head-quarters.png': ['Objekat kompanije uz kompleks plastenika', 'The company building beside the greenhouse complex'],
  'babura-5.jpg': ['Babura u redovima plastenika', 'Babura along the greenhouse rows'],
  'aerial-haze-3.jpg': ['Plastenici u jutarnjem svetlu', 'Greenhouses in the morning light'],
  'export-babura-2.jpg': ['Kutija babure za izvoz', 'A box of babura for export'],
};

/*
 * Masonry layouts, column by column, top to bottom. `wide` is three columns
 * (from 52rem of width), `narrow` two. Arranged so neighbours differ in
 * subject and no two columns break at almost the same height. '+' is the
 * "see more" tile. GalleryMasonry checks every photo appears once per layout.
 */
const previewLayout = {
  wide: [
    ['babura-4.jpg', 'greenhouse-rows.jpg', 'silja-2.jpg', 'export-babura-boxes.jpg'],
    ['aerial-haze.jpg', 'babura-vine.jpg', 'packing-hall-2.jpg'],
    ['silja-3.jpg', 'babura-plants-2.jpg', 'silja-crates.jpg', '+'],
  ],
  narrow: [
    ['babura-4.jpg', 'packing-hall-2.jpg', 'silja-2.jpg', 'export-babura-boxes.jpg', 'silja-3.jpg', 'aerial-haze.jpg'],
    ['silja-crates.jpg', 'babura-vine.jpg', 'greenhouse-rows.jpg', 'babura-plants-2.jpg', '+'],
  ],
};

const moreLayout = {
  wide: [
    ['babura-3.jpg', 'silja-vine.jpg', 'export-babura-1.jpg', 'greenhouse-block-2.jpg', 'babura-2.jpg', 'packing-silja.jpg', 'babura-5.jpg'],
    ['aerial-haze-2.jpg', 'greenhouse-block.jpg', 'silja-growth-2.jpg', 'export-babura-3.jpg', 'silja-channel.jpg', 'babura-6.jpg', 'aerial-haze-3.jpg'],
    ['babura-crates.png', 'silja-growth.jpg', 'packing-hall.jpg', 'babura-plants.jpg', 'export-silja.jpg', 'head-quarters.png', 'export-babura-2.jpg'],
  ],
  narrow: [
    ['babura-3.jpg', 'aerial-haze-2.jpg', 'greenhouse-block.jpg', 'export-babura-2.jpg', 'head-quarters.png', 'babura-5.jpg', 'export-silja.jpg', 'babura-plants.jpg', 'silja-channel.jpg', 'export-babura-3.jpg', 'silja-growth.jpg'],
    ['packing-hall.jpg', 'babura-crates.png', 'silja-vine.jpg', 'greenhouse-block-2.jpg', 'packing-silja.jpg', 'babura-2.jpg', 'aerial-haze-3.jpg', 'export-babura-1.jpg', 'silja-growth-2.jpg', 'babura-6.jpg'],
  ],
};

/** Source, alt text and pre-rendered lightbox version for every photo in a layout. */
async function photosIn(layout: { wide: string[][] }) {
  const files = layout.wide.flat().filter((file) => file !== '+');
  const entries = await Promise.all(
    files.map(async (file) => {
      const text = alts[file];
      if (!text) throw new Error(`Gallery photo without alt text: ${file}`);
      const src = image(file);
      const full = await getImage({ src, width: 1800, format: 'webp', quality: 78 });
      return [file, { src, alt: sr ? text[0] : text[1], full: full.src }] as const;
    })
  );
  return Object.fromEntries(entries);
}

const [previewPhotos, morePhotos] = await Promise.all([photosIn(previewLayout), photosIn(moreLayout)]);

const moreTotal = Object.keys(morePhotos).length;
const moreCount = (
  t.gallery.moreCount[new Intl.PluralRules(locale).select(moreTotal)] ?? t.gallery.moreCount.other
).replace('{count}', String(moreTotal));

/** A glimpse of what the "+" tile opens: the top of the full gallery. */
const mosaic = ['babura-3.jpg', 'aerial-haze-2.jpg', 'babura-crates.png', 'silja-vine.jpg'].map(image);
---

<section id="gallery" class="gallery-surface section-pad text-cream-50">
  <div class="container-site">
    <SectionHead number="06" kicker={t.gallery.kicker} title={t.gallery.title} tone="dark" />

    <GalleryMasonry
      class="mt-14 md:mt-20"
      photos={previewPhotos}
      layout={previewLayout}
      label={t.a11y.galleryOpen}
      sizes="(min-width: 57rem) 30vw, 46vw"
      reveal
    >
      <button
        slot="tile"
        type="button"
        class="gallery-more-tile"
        aria-label={`${t.gallery.more}: ${moreCount}`}
        aria-haspopup="dialog"
        aria-controls="gallery-more"
        data-gallery-more-open
      >
        <span class="gallery-more-mosaic" aria-hidden="true">
          {mosaic.map((src) => <Image src={src} alt="" widths={[240, 400]} sizes="(min-width: 57rem) 15vw, 23vw" />)}
        </span>
        <span class="gallery-more-body">
          <span class="gallery-more-plus" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 4v16M4 12h16" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="gallery-more-label">
            <span class="gallery-more-kicker">{t.gallery.more}</span>
            <span class="gallery-more-count">{moreCount}</span>
          </span>
        </span>
      </button>
    </GalleryMasonry>
  </div>
</section>

<!-- Full gallery -->
<dialog
  id="gallery-more"
  class="gallery-more gallery-surface m-auto overflow-hidden rounded-2xl p-0 text-cream-50"
  aria-labelledby="gallery-more-title"
  data-lenis-prevent
>
  <div class="flex h-full flex-col">
    <header class="flex items-start justify-between gap-6 border-b rule-dark px-5 py-5 md:px-10 md:py-7">
      <div class="flex flex-col gap-3">
        <p class="kicker flex items-center gap-4 text-sage-300">
          <span class="h-px w-8 bg-ember-400" aria-hidden="true"></span>
          <span>{t.gallery.kicker} · <span class="whitespace-nowrap">{moreCount}</span></span>
        </p>
        <h2 id="gallery-more-title" class="font-display text-display-md font-[550] text-balance text-cream-50">
          {t.gallery.moreTitle}
        </h2>
      </div>
      <button
        type="button"
        class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors duration-300 hover:border-cream-50/70 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ember-500"
        aria-label={t.a11y.lightboxClose}
        data-gallery-more-close
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </header>

    <div class="gallery-more-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pt-6 pb-10 md:px-10 md:pt-8">
      <GalleryMasonry
        photos={morePhotos}
        layout={moreLayout}
        label={t.a11y.galleryOpen}
        sizes="(min-width: 62rem) 28vw, 45vw"
      />
    </div>
  </div>
</dialog>

<!-- Lightbox -->
<dialog
  id="lightbox"
  class="m-auto h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-forest-950/95"
  data-lenis-prevent
>
  <div class="lightbox-stage">
    {
      [0, 1].map(() => (
        <figure class="lightbox-slide" data-lightbox-slide aria-hidden="true">
          <img class="lightbox-img" alt="" decoding="async" />
          <figcaption class="lightbox-caption" />
        </figure>
      ))
    }
    <p id="lightbox-status" class="sr-only" aria-live="polite"></p>

    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:top-6 md:right-6"
      aria-label={t.a11y.lightboxClose}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-prev"
      class="absolute top-1/2 left-2 z-10 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:left-6"
      aria-label={t.a11y.lightboxPrev}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-next"
      class="absolute top-1/2 right-2 z-10 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-cream-50/25 text-cream-50 transition-colors hover:border-cream-50/70 md:right-6"
      aria-label={t.a11y.lightboxNext}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</dialog>

<style>
  /* Deep forest with a soft green light from above: photos stand out,
     and the section settles into the dark contact block below. */
  .gallery-surface {
    background-color: var(--color-forest-800);
    background-image:
      radial-gradient(64rem 30rem at 50% 0%, color-mix(in srgb, var(--color-forest-600) 62%, transparent), transparent 72%),
      radial-gradient(46rem 34rem at 100% 70%, color-mix(in srgb, var(--color-sage-300) 7%, transparent), transparent 70%),
      linear-gradient(180deg, transparent 45%, var(--color-forest-900));
  }

  /* ── "+" tile ──────────────────────────────────────────────────── */

  .gallery-more-tile {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--color-forest-950);
    color: var(--color-cream-50);
    cursor: pointer;
    container-type: inline-size;
    transition: scale 0.35s var(--ease-out-quart);
  }

  /* Hairline ring above the photos, so the tile reads as a control. */
  .gallery-more-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-cream-50) 16%, transparent);
    pointer-events: none;
    transition: box-shadow 0.4s var(--ease-out-quart);
  }

  .gallery-more-mosaic {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    grid-template: minmax(0, 1fr) minmax(0, 1fr) / minmax(0, 1fr) minmax(0, 1fr);
    gap: 2px;
  }

  .gallery-more-mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s var(--ease-out-quart);
  }

  /* Darkest behind the label; the photos show through towards the edges. */
  .gallery-more-mosaic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-forest-950) 84%, transparent),
      color-mix(in srgb, var(--color-forest-950) 60%, transparent)
    );
    transition: opacity 0.4s var(--ease-out-quart);
  }

  .gallery-more-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 6cqi, 1.25rem);
    padding: 1rem;
    text-align: center;
  }

  .gallery-more-plus {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 18cqi, 4.25rem);
    aspect-ratio: 1;
    border-radius: 9999px;
    background-color: var(--color-ember-500);
    box-shadow: 0 0.75rem 2rem -0.5rem color-mix(in srgb, var(--color-ember-500) 55%, transparent);
    transition:
      background-color 0.4s var(--ease-out-quart),
      scale 0.5s var(--ease-out-expo);
  }

  .gallery-more-plus svg {
    width: 44%;
    height: 44%;
    transition: rotate 0.5s var(--ease-out-expo);
  }

  .gallery-more-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .gallery-more-kicker {
    font-size: clamp(0.6875rem, 3.4cqi, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-more-count {
    font-size: clamp(0.8125rem, 3.8cqi, 0.9375rem);
    color: var(--color-sage-200);
  }

  @media (hover: hover) {
    .gallery-more-tile:hover .gallery-more-mosaic :global(img) {
      scale: 1.06;
    }

    .gallery-more-tile:hover .gallery-more-mosaic::after {
      opacity: 0.8;
    }

    .gallery-more-tile:hover .gallery-more-plus {
      background-color: var(--color-ember-400);
      scale: 1.08;
    }

    .gallery-more-tile:hover .gallery-more-plus svg {
      rotate: 90deg;
    }

    .gallery-more-tile:hover::after {
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-cream-50) 34%, transparent);
    }
  }

  .gallery-more-tile:active {
    scale: 0.985;
  }

  .gallery-more-tile:focus-visible {
    outline: 2px solid var(--color-ember-500);
    outline-offset: 3px;
  }

  /* ── Full gallery dialog ───────────────────────────────────────── */

  .gallery-more {
    width: calc(100vw - 1rem);
    height: calc(100dvh - 1rem);
    max-width: none;
    max-height: none;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-cream-50) 9%, transparent),
      0 2.5rem 6rem -1.5rem rgb(0 0 0 / 0.6);
    opacity: 0;
    transform: translateY(0.75rem) scale(0.985);
    transition:
      opacity 0.35s var(--ease-out-quart),
      transform 0.45s var(--ease-out-expo);
  }

  .gallery-more[data-open] {
    opacity: 1;
    transform: none;
  }

  .gallery-more::backdrop {
    background: color-mix(in srgb, var(--color-forest-950) 72%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out-quart);
  }

  .gallery-more[data-open]::backdrop {
    opacity: 1;
  }

  .gallery-more-scroll {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-sage-300) 40%, transparent) transparent;
  }

  @media (min-width: 768px) {
    .gallery-more {
      width: min(92vw, 84rem);
      height: min(90dvh, 62rem);
    }
  }

  /* ── Lightbox ──────────────────────────────────────────────────── */

  /* Two slides share one cell and trade places on every step, so a change
     never moves the layout: each is sized to its own photo + caption. */
  .lightbox-stage {
    --pad-x: 1rem;
    --pad-y: 1rem;
    --caption: 2.75rem;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--pad-y) var(--pad-x);
    overflow: hidden;
    container-type: size;
  }

  @media (min-width: 48rem) {
    .lightbox-stage {
      --pad-x: 5.5rem;
      --pad-y: 2.5rem;
    }
  }

  .lightbox-slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .lightbox-slide.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100cqw;
    max-height: calc(100cqh - var(--caption));
    border-radius: 0.5rem;
    box-shadow: 0 1.5rem 3rem -0.75rem rgb(0 0 0 / 0.45);
  }

  .lightbox-caption {
    max-width: 36rem;
    min-height: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-align: center;
    color: var(--color-sage-200);
  }
</style>

<script>
  /* Page scroll stays locked while any gallery dialog is open; the gutter is
     kept so the page doesn't shift sideways when the scrollbar goes. */
  const root = document.documentElement;
  const anyOpen = () => !!document.querySelector('#lightbox[open], #gallery-more[open]');
  const lockScroll = () => {
    root.style.scrollbarGutter = 'stable';
    root.style.overflow = 'hidden';
  };
  const releaseScroll = () => {
    if (anyOpen()) return;
    root.style.overflow = '';
    root.style.scrollbarGutter = '';
  };

  /* ── Lightbox ─────────────────────────────────────────────────── */
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;
  const slides = Array.from(dialog.querySelectorAll<HTMLElement>('[data-lightbox-slide]'));
  const status = document.getElementById('lightbox-status')!;
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')
  );
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  let index = 0; // photo on screen
  let current = 0; // slide showing it
  let busy = false; // a change is under way; navigation waits for it
  let run = 0; // bumped on open/close so stale async steps bow out

  const wrap = (i: number) => (i + triggers.length) % triggers.length;
  const photo = (i: number) => {
    const trigger = triggers[wrap(i)]!;
    return { src: trigger.dataset.full!, alt: trigger.querySelector('img')?.alt ?? '' };
  };

  /** Puts photo i on a slide; resolves once it's decoded (capped), so a
      slide never moves in half-drawn. */
  const fill = (slide: HTMLElement, i: number) => {
    const { src, alt } = photo(i);
    const img = slide.querySelector('img')!;
    img.alt = alt;
    slide.querySelector('figcaption')!.textContent = alt;
    if (img.getAttribute('src') !== src) img.src = src;
    return Promise.race([
      img.decode().catch(() => undefined),
      new Promise((done) => setTimeout(done, 1500)),
    ]);
  };

  const preload = (i: number) => {
    new Image().src = photo(i).src;
  };

  const activate = (slide: HTMLElement, on: boolean) => {
    slide.classList.toggle('is-active', on);
    slide.setAttribute('aria-hidden', String(!on));
  };

  const open = async (i: number) => {
    const my = ++run;
    busy = true;
    index = wrap(i);
    current = 0;
    slides.forEach((slide) => {
      slide.getAnimations().forEach((a) => a.cancel());
      activate(slide, false);
    });
    dialog.showModal();
    lockScroll();
    const slide = slides[0]!;
    await fill(slide, index);
    if (my !== run) return;
    activate(slide, true);
    status.textContent = photo(index).alt;
    slide.animate({ opacity: [0, 1] }, { duration: still.matches ? 150 : 320, easing: 'ease-out' });
    busy = false;
    preload(index + 1);
    preload(index - 1);
  };

  /* The new photo comes in from the side of the button pressed while the
     old one drifts out the other way; photo and caption move as one. */
  const go = async (dir: 1 | -1) => {
    if (busy || !dialog.open) return;
    busy = true;
    const my = run;
    // A step taken while the last one is still easing in finishes it first.
    slides.forEach((slide) => slide.getAnimations().forEach((a) => a.finish()));
    const from = slides[current]!;
    const to = slides[1 - current]!;
    const next = wrap(index + dir);
    await fill(to, next);
    if (my !== run) return;
    index = next;
    current = 1 - current;
    activate(from, false);
    activate(to, true);
    status.textContent = photo(index).alt;

    const shift = still.matches ? 0 : Math.min(window.innerWidth * 0.07, 88);
    const at = (x: number) => `translate3d(${x}px, 0, 0)`;
    to.animate(
      { opacity: [0, 1], transform: [at(dir * shift), at(0)] },
      { duration: still.matches ? 160 : 640, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
    );
    const leave = from.animate(
      { opacity: [1, 0], transform: [at(0), at(-dir * shift * 0.6)] },
      { duration: still.matches ? 160 : 380, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' }
    );
    // Further clicks wait until the old photo has gone.
    await leave.finished.catch(() => undefined);
    if (my === run) busy = false;
    preload(index + dir);
  };

  triggers.forEach((trigger, i) => {
    trigger.addEventListener('click', () => void open(i));
  });

  /* Our own close paths tidy up directly; the 'close' listener covers the
     native Escape path. Both are safe to run twice. */
  const afterLightbox = () => {
    run++;
    busy = false;
    slides.forEach((slide) => slide.getAnimations().forEach((a) => a.cancel()));
    releaseScroll();
    triggers[index]?.focus();
  };
  const close = () => {
    dialog.close();
    afterLightbox();
  };
  dialog.addEventListener('close', afterLightbox);

  document.getElementById('lightbox-close')!.addEventListener('click', close);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => void go(-1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => void go(1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') void go(-1);
    if (e.key === 'ArrowRight') void go(1);
  });

  /* A click on the dark area around the photo closes */
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === stage) close();
  });

  /* ── Full gallery dialog ──────────────────────────────────────── */
  const more = document.getElementById('gallery-more') as HTMLDialogElement;
  const opener = document.querySelector<HTMLButtonElement>('[data-gallery-more-open]')!;

  const openMore = () => {
    more.showModal();
    lockScroll();
    // Flush styles first so the entrance transition runs from the closed state.
    void more.offsetWidth;
    more.setAttribute('data-open', '');
  };

  const afterMore = () => {
    releaseScroll();
    opener.focus();
  };

  let closing = false;
  const closeMore = () => {
    if (!more.open || closing) return;
    closing = true;
    more.removeAttribute('data-open');
    const done = () => {
      clearTimeout(fallback);
      more.removeEventListener('transitionend', onEnd);
      closing = false;
      more.close();
      afterMore();
    };
    const onEnd = (e: TransitionEvent) => {
      if (e.target === more && e.propertyName === 'opacity') done();
    };
    // Reduced motion shortens transitions to ~0; the timeout covers any
    // case where transitionend never fires.
    const fallback = window.setTimeout(done, 500);
    more.addEventListener('transitionend', onEnd);
  };

  opener.addEventListener('click', openMore);
  more.querySelector('[data-gallery-more-close]')!.addEventListener('click', closeMore);

  // Escape: animate out instead of the dialog's instant close.
  more.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeMore();
  });

  more.addEventListener('click', (e) => {
    if (e.target === more) closeMore();
  });

  more.addEventListener('close', afterMore);
</script>
