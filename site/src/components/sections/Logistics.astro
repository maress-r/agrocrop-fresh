---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import { getDictionary, type Locale } from '../../i18n';
import type { LogisticsStep } from '../../i18n/types';

import hallPhoto from '../../assets/photos/pakirni-centar.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const l = t.logistics;
const sr = locale === 'sr';

/*
 * One journey in three phases — packing → cold chain → export.
 *
 * With motion and room for it (lg+, see the media query in the styles), the
 * packing-centre photograph becomes a stage that stays in view while
 * scrolling moves through the phases: number, icon and copy change, the
 * camera pulls back from the packing line to the whole hall, the process
 * line fills (script at the bottom). Everywhere else — small screens,
 * reduced motion, no JS — the same markup reads as the hall followed by
 * the three phases, one after another.
 */
const num = (i: number) => String(i + 1).padStart(2, '0');

const hallAlt = sr
  ? 'Pakirni centar: hala sa linijom stolova za pakovanje'
  : 'The packing centre: a hall with a line of packing tables';

/* ── Icons: 48-unit line drawings, each stroke drawn in (class "draw") ── */

const r2 = (n: number) => Math.round(n * 100) / 100;
const stroke = (tag: string, delay = 0) =>
  `<${tag} pathLength="1" class="draw"${delay ? ` style="--draw-delay: ${delay}s"` : ''}/>`;

/** Snowflake: six arms from the centre, then a pair of branches on each. */
function snowflake() {
  const c = 24;
  let out = '';
  for (let k = 0; k < 6; k++) {
    const a = (k * Math.PI) / 3 - Math.PI / 2;
    const at = (len: number) => [c + Math.cos(a) * len, c + Math.sin(a) * len] as const;
    const tip = at(17);
    const fork = at(10.5);
    const branches = [-1, 1]
      .map((s) => {
        const b = a + (s * Math.PI) / 3;
        return `M${r2(fork[0])} ${r2(fork[1])}L${r2(fork[0] + Math.cos(b) * 5.2)} ${r2(fork[1] + Math.sin(b) * 5.2)}`;
      })
      .join('');
    out += stroke(`path d="M${c} ${c}L${r2(tip[0])} ${r2(tip[1])}"`) + stroke(`path d="${branches}"`, 0.55);
  }
  return out;
}

const icons: Record<LogisticsStep['id'], string> = {
  // Produce crate, pepper shoulders showing above the rim.
  pack: [
    stroke('path d="M5 19.5H43"'),
    stroke('path d="M7.2 19.5 9.5 37.8a2 2 0 0 0 2 1.7h25a2 2 0 0 0 2-1.7l2.3-18.3"'),
    stroke('path d="M8.1 26.5h31.8M9 33h30"', 0.3),
    stroke('path d="M20.5 23h7"', 0.3),
    stroke('path d="M10.5 19.5C10.3 14.9 12.5 12 16.1 12c2.9 0 4.8 2.2 4.9 5.5"', 0.5),
    stroke('path d="M20.3 15.2C21.3 12.6 23.3 11 25.9 11c2.7 0 4.7 1.7 5.6 4.4"', 0.6),
    stroke('path d="M31 17.4c.2-3.2 2-5.2 4.6-5.2 3.3 0 5.1 2.8 4.9 7.3"', 0.7),
    stroke('path d="M16.2 12V9.6M25.8 11V8c0-1 .7-1.7 1.7-1.7M35.2 12.2V10"', 0.9),
  ].join(''),
  cold: snowflake(),
  // Box truck, side view.
  export: [
    stroke('path d="M9.6 33.5H6A1.5 1.5 0 0 1 4.5 32V15A1.5 1.5 0 0 1 6 13.5h21.5A1.5 1.5 0 0 1 29 15v18.5"'),
    stroke('path d="M17.4 33.5h13.2"'),
    stroke(
      'path d="M29 20h6.6a2 2 0 0 1 1.6.8l5 6.4a2 2 0 0 1 .4 1.2V32a1.5 1.5 0 0 1-1.5 1.5h-2.7"',
      0.25
    ),
    stroke('path d="M33.5 20v6.5h9"', 0.5),
    stroke('circle cx="13.5" cy="34" r="3.9"', 0.4),
    stroke('circle cx="34.5" cy="34" r="3.9"', 0.5),
    stroke('path d="M9.5 19.5h8M9.5 24h4.5"', 0.8),
  ].join(''),
};

const iconAttrs = {
  viewBox: '0 0 48 48',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<section id="logistics" class="section-pad bg-cream-50">
  <div class="container-site">
    <SectionHead
      number="05"
      kicker={l.kicker}
      title={l.title}
      lede={l.lede}
    />

    <div class="journey mt-16 md:mt-24" data-journey>
      {/* Where the process line's links land while the stage is pinned. */}
      {l.steps.map((step, i) => <span id={`logistics-${step.id}`} class="journey-anchor" style={`--i: ${i}`} />)}

      <div class="journey-stage" data-journey-stage data-phase="0">
        <figure class="journey-hall">
          <div class="journey-hall-photo grain" data-reveal>
            <div class="journey-hall-camera">
              <Image
                src={hallPhoto}
                alt={hallAlt}
                widths={[640, 1000, 1448]}
                sizes="(min-width: 90rem) 82rem, 92vw"
                class="journey-hall-img"
              />
            </div>
          </div>
          <figcaption class="journey-hall-caption">
            <span class="uppercase">{l.hall.label}</span>
            <span aria-hidden="true">·</span>
            <span>{l.hall.area}</span>
          </figcaption>
        </figure>

        <ol class="journey-chapters">
          {
            l.steps.map((step, i) => (
              <li
                class="journey-chapter"
                data-journey-chapter
                data-state={i === 0 ? 'active' : 'next'}
                data-inview
              >
                <div class="journey-copy">
                  <p class="journey-mark" style="--k: 0">
                    <span class="journey-num font-display">{num(i)}</span>
                    <span class="journey-rule" aria-hidden="true" />
                    <svg {...iconAttrs} class="journey-icon" set:html={icons[step.id]} />
                  </p>
                  <h3 class="journey-title" style="--k: 1">
                    {step.title}
                  </h3>
                  <p class="journey-text" style="--k: 2">
                    {step.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <nav class="journey-track" aria-label={l.stepsLabel}>
          <span class="journey-track-line" aria-hidden="true">
            <span class="journey-track-fill" />
          </span>
          <ol>
            {
              l.steps.map((step, i) => (
                <li>
                  <a
                    href={`#logistics-${step.id}`}
                    class="journey-stop"
                    data-journey-stop
                    data-state={i === 0 ? 'active' : 'next'}
                    aria-current={i === 0 ? 'step' : undefined}
                  >
                    <svg {...iconAttrs} class="journey-stop-icon" set:html={icons[step.id]} />
                    <span>{step.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── The phases, one after another (base layout) ───────────────── */

  .journey {
    position: relative;
  }

  .journey-anchor,
  .journey-track,
  .journey-rule {
    display: none;
  }

  .journey-hall-photo {
    overflow: hidden;
    border-radius: 1rem;
    aspect-ratio: 4 / 3;
  }

  .journey-hall-caption {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--color-ink-600);
  }

  .journey-hall-caption::before {
    content: '';
    width: 2rem;
    height: 1px;
    flex: none;
    margin-right: 0.25rem;
    background: var(--color-ember-500);
  }

  .journey-hall-camera {
    height: 100%;
  }

  .journey-hall :global(.journey-hall-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journey-chapters {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }

  .journey-chapter {
    padding-block: 2.5rem;
  }

  .journey-chapter + .journey-chapter {
    border-top: 1px solid color-mix(in srgb, var(--color-ink-900) 12%, transparent);
  }

  .journey-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .journey-mark {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .journey-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 520;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ember-600);
  }

  .journey-icon {
    width: 2.875rem;
    height: 2.875rem;
    flex: none;
    stroke-width: 1.25;
    color: var(--color-ink-900);
  }

  .journey-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 550;
    line-height: 1.12;
    letter-spacing: -0.008em;
    text-wrap: balance;
    color: var(--color-ink-900);
  }

  .journey-text {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-600);
  }

  @media (min-width: 48rem) {
    .journey-hall-photo {
      aspect-ratio: 16 / 9;
      border-radius: 1.25rem;
    }

    .journey-chapters {
      margin-top: 1.5rem;
    }

    .journey-chapter {
      padding-block: 3rem;
    }

    .journey-copy {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem 2rem;
    }

    .journey-mark {
      grid-row: 1 / span 2;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1.5rem;
    }
  }

  /* Wide but not pinned (reduced motion, short windows): three columns. */
  @media (min-width: 64rem) {
    .journey-hall-photo {
      aspect-ratio: 21 / 9;
    }

    .journey-chapters {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 3.5rem);
      margin-top: 3.5rem;
    }

    .journey-chapter,
    .journey-chapter + .journey-chapter {
      border-top: 1px solid color-mix(in srgb, var(--color-ink-900) 12%, transparent);
      padding-block: 2rem 0;
    }

    .journey-copy {
      display: flex;
    }

    .journey-mark {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Phases rise into place once seen (motion allowed, stage not pinned). */
  @media (max-width: 63.999rem), (max-height: 41.999rem) {
    :global(html.has-motion) .journey-copy > * {
      transition:
        opacity 0.9s var(--ease-out-quart) calc(var(--k, 0) * 0.09s),
        translate 1.1s var(--ease-out-expo) calc(var(--k, 0) * 0.09s);
    }

    :global(html.has-motion) .journey-chapter:not(:global(.is-inview)) .journey-copy > * {
      opacity: 0;
      translate: 0 1.75rem;
    }
  }

  /* ── The pinned stage (lg+, room to play it, motion allowed) ───── */

  @media (min-width: 64rem) and (min-height: 42rem) {
    :global(html.has-motion) .journey {
      --stage-h: min(100svh - 8.5rem, 54rem);
      --stage-top: calc((100svh - var(--stage-h)) / 2 + 2.75rem);
      /* Scroll distance spent inside the stage: a third per phase. */
      --travel: 180svh;
      --pad: clamp(2.25rem, 4vw, 3.75rem);
      height: calc(var(--stage-h) + var(--travel));
    }

    :global(html.has-motion) .journey-anchor {
      position: absolute;
      top: calc(var(--travel) * var(--i) / 3 + 2px);
      display: block;
      width: 1px;
      height: 1px;
      scroll-margin-top: var(--stage-top);
      pointer-events: none;
    }

    :global(html.has-motion) .journey-stage {
      position: sticky;
      top: var(--stage-top);
      isolation: isolate;
      height: var(--stage-h);
      overflow: hidden;
      border-radius: 1.5rem;
      background: var(--color-forest-950);
      color: var(--color-cream-50);
    }

    /* The hall fills the stage. The camera starts close on the packing line
       and pulls back a step with each phase; the photo drifts with the scroll. */
    :global(html.has-motion) .journey-hall-photo {
      position: absolute;
      inset: 0;
      z-index: -2;
      border-radius: 0;
      aspect-ratio: auto;
    }

    :global(html.has-motion) .journey-hall-caption {
      position: absolute;
      top: var(--pad);
      left: var(--pad);
      z-index: 1;
      margin: 0;
      color: color-mix(in srgb, var(--color-cream-50) 72%, transparent);
    }

    :global(html.has-motion) .journey-hall-caption::before {
      background: var(--color-ember-400);
    }

    :global(html.has-motion) .journey-hall-camera {
      transform: scale(1.16);
      transform-origin: 70% 62%;
      transition: transform 1.8s var(--ease-out-expo);
      will-change: transform;
    }

    :global(html.has-motion) .journey-stage[data-phase='1'] .journey-hall-camera {
      transform: scale(1.08);
    }

    :global(html.has-motion) .journey-stage[data-phase='2'] .journey-hall-camera {
      transform: scale(1);
    }

    :global(html.has-motion) .journey-hall :global(.journey-hall-img) {
      object-position: 50% 58%;
      transform: scale(1.06) translate3d(calc((0.5 - var(--p, 0)) * 3.2%), 0, 0);
      will-change: transform;
    }

    /* Forest wash: copy on the left and the line below stay legible. */
    :global(html.has-motion) .journey-stage::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-forest-950) 88%, transparent) 0%,
          color-mix(in srgb, var(--color-forest-950) 34%, transparent) 30%,
          transparent 52%
        ),
        linear-gradient(
          to right,
          color-mix(in srgb, var(--color-forest-950) 90%, transparent) 0%,
          color-mix(in srgb, var(--color-forest-950) 72%, transparent) 34%,
          color-mix(in srgb, var(--color-forest-950) 26%, transparent) 64%,
          color-mix(in srgb, var(--color-forest-950) 16%, transparent) 100%
        );
      pointer-events: none;
    }

    :global(html.has-motion) .journey-chapters {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
    }

    :global(html.has-motion) .journey-chapter,
    :global(html.has-motion) .journey-chapter + .journey-chapter {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      border: 0;
      padding: var(--pad) var(--pad) 8.25rem;
      pointer-events: none;
    }

    :global(html.has-motion) .journey-chapter[data-state='active'] .journey-copy {
      pointer-events: auto;
    }

    :global(html.has-motion) .journey-copy {
      display: flex;
      max-width: 38rem;
      flex-direction: column;
      gap: clamp(1rem, 2.4svh, 1.5rem);
    }

    :global(html.has-motion) .journey-mark {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 1.5rem;
    }

    :global(html.has-motion) .journey-num {
      font-size: clamp(4rem, min(7vw, 12svh), 6.75rem);
      line-height: 0.9;
      color: var(--color-ember-400);
    }

    :global(html.has-motion) .journey-rule {
      display: block;
      width: 1px;
      height: clamp(2.75rem, 7svh, 4rem);
      background: color-mix(in srgb, var(--color-cream-50) 28%, transparent);
    }

    :global(html.has-motion) .journey-icon {
      width: clamp(4rem, 10svh, 5.5rem);
      height: clamp(4rem, 10svh, 5.5rem);
      stroke-width: 1;
      color: var(--color-cream-50);
    }

    :global(html.has-motion) .journey-title {
      max-width: 15ch;
      font-size: clamp(2.5rem, min(4.5vw, 7.6svh), 4.25rem);
      line-height: 1.04;
      letter-spacing: -0.012em;
      color: var(--color-cream-50);
    }

    :global(html.has-motion) .journey-text {
      max-width: 31rem;
      font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
      line-height: 1.6;
      color: color-mix(in srgb, var(--color-cream-50) 86%, transparent);
    }

    /* Phase states: waiting below, in place, gone above. */
    :global(html.has-motion) .journey-copy > * {
      opacity: 0;
      transition:
        opacity 0.4s var(--ease-out-quart),
        translate 0.55s var(--ease-out-quart);
    }

    :global(html.has-motion) .journey-chapter .journey-copy > * {
      translate: 0 2.25rem;
    }

    :global(html.has-motion) .journey-chapter[data-state='past'] .journey-copy > * {
      translate: 0 -1.75rem;
    }

    :global(html.has-motion) .journey-chapter[data-state='active']:global(.is-inview) .journey-copy > * {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.8s var(--ease-out-quart) calc(0.16s + var(--k, 0) * 0.09s),
        translate 1.1s var(--ease-out-expo) calc(0.16s + var(--k, 0) * 0.09s);
    }

    /* A phase's icon draws itself each time the phase comes in. */
    :global(html.has-motion) .journey-chapter:not([data-state='active']) .journey-icon :global(.draw) {
      stroke-dashoffset: 1;
      transition-duration: 0.2s;
      transition-delay: 0s;
    }

    /* ── Process line ────────────────────────────────────────────── */

    :global(html.has-motion) .journey-track {
      position: absolute;
      inset: auto var(--pad) 2.25rem;
      z-index: 1;
      display: block;
    }

    .journey-track-line {
      position: relative;
      display: block;
      height: 1px;
      background: color-mix(in srgb, var(--color-cream-50) 24%, transparent);
    }

    .journey-track-fill {
      position: absolute;
      inset: -0.5px 0;
      background: var(--color-ember-400);
      transform: scaleX(var(--p, 0));
      transform-origin: left;
    }

    .journey-track ol {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .journey-stop {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.125rem 1rem 0.25rem 0;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--color-cream-50) 52%, transparent);
      transition: color 0.45s var(--ease-out-quart);
    }

    /* The stop's marker, sitting on the line. */
    .journey-stop::before {
      content: '';
      position: absolute;
      top: -0.25rem;
      left: 0;
      width: 0.4375rem;
      height: 0.4375rem;
      border-radius: 9999px;
      background: color-mix(in srgb, var(--color-cream-50) 46%, var(--color-forest-950));
      transition:
        background-color 0.45s var(--ease-out-quart),
        box-shadow 0.45s var(--ease-out-quart);
    }

    .journey-stop-icon {
      width: 1.375rem;
      height: 1.375rem;
      flex: none;
      stroke-width: 2.6;
    }

    .journey-stop[data-state='done'] {
      color: color-mix(in srgb, var(--color-cream-50) 78%, transparent);
    }

    .journey-stop[data-state='active'] {
      color: var(--color-cream-50);
    }

    .journey-stop:is([data-state='done'], [data-state='active'])::before {
      background: var(--color-ember-400);
    }

    .journey-stop[data-state='active']::before {
      box-shadow: 0 0 0 0.3125rem color-mix(in srgb, var(--color-ember-400) 24%, transparent);
    }

    @media (hover: hover) {
      .journey-stop:hover {
        color: var(--color-cream-50);
      }
    }
  }
</style>

<script>
  /* ── Pinned stage: scroll position → phase, camera, line, drift ── */
  const journey = document.querySelector<HTMLElement>('[data-journey]');
  const stage = journey?.querySelector<HTMLElement>('[data-journey-stage]');

  // Same gates as the styles: motion allowed (the class set in <head>) and
  // a viewport the stage fits into.
  if (journey && stage && document.documentElement.classList.contains('has-motion')) {
    const chapters = Array.from(journey.querySelectorAll<HTMLElement>('[data-journey-chapter]'));
    const stops = Array.from(journey.querySelectorAll<HTMLAnchorElement>('[data-journey-stop]'));
    const pinned = window.matchMedia('(min-width: 64rem) and (min-height: 42rem)');
    const count = chapters.length;
    let active = -1;
    let frame = 0;
    let travel = 1;
    let stuckAt = 0;

    /** Where the stage sticks and how far the page scrolls while it does. */
    const measure = () => {
      travel = Math.max(1, journey.offsetHeight - stage.offsetHeight);
      stuckAt = parseFloat(getComputedStyle(stage).top) || 0;
    };

    const update = () => {
      frame = 0;
      if (!pinned.matches) return;

      // 0 when the stage sticks, 1 when it lets go.
      const p = Math.min(1, Math.max(0, (stuckAt - journey.getBoundingClientRect().top) / travel));
      journey.style.setProperty('--p', p.toFixed(4));

      const next = Math.min(count - 1, Math.floor(p * count));
      if (next === active) return;
      active = next;
      stage.dataset.phase = String(active);
      chapters.forEach((chapter, i) => {
        chapter.dataset.state = i < active ? 'past' : i === active ? 'active' : 'next';
      });
      stops.forEach((stop, i) => {
        stop.dataset.state = i < active ? 'done' : i === active ? 'active' : 'next';
        if (i === active) stop.setAttribute('aria-current', 'step');
        else stop.removeAttribute('aria-current');
      });
    };

    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    const remeasure = () => {
      measure();
      schedule();
    };

    // Follow the scroll only while the journey is near the viewport.
    new IntersectionObserver(
      ([entry]) => {
        if (entry!.isIntersecting) {
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', remeasure);
        } else {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', remeasure);
        }
        remeasure();
      },
      { rootMargin: '25% 0px' }
    ).observe(journey);

    pinned.addEventListener('change', () => {
      active = -1;
      remeasure();
    });
  }
</script>
