---
import SectionHead from '../ui/SectionHead.astro';
import PepperPlant from '../PepperPlant.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="story" class="story bg-cream-100 pt-(--spacing-section)"
  data-scroll-camera="(min-width: 768px)"
>
  <div class="container-site">
    <SectionHead number="01" kicker={t.story.kicker} title={t.story.title} titleClass="max-w-4xl" />
  </div>

  {/*
    The camera only runs from md (768px) up, where chapters sit left / right
    of the plant; below that they stack, so plain vertical scroll reads better.

    Camera stage. With motion it is pinned and becomes the frame the camera
    looks through (scripts/scroll-camera.ts); without it — reduced motion or no
    JS — it is ordinary flow and the chapters read as a static zig-zag around
    the plant.
  */}
  <div class="story-stage" data-camera-stage>
    <div class="story-world" data-camera-world>
      <div class="story-plant" data-camera-depth="0.3">
        <PepperPlant />
      </div>

      <ol class="story-chapters">
        {
          t.story.chapters.map((chapter, i) => (
            <li class="story-chapter" data-camera-shot data-side={i % 2 === 0 ? 'left' : 'right'}>
              <p class="kicker flex items-center gap-4 text-ink-600">
                <span class="h-px w-8 bg-ember-500" aria-hidden="true" />
                <span>{chapter.era}</span>
              </p>
              <h3 class="mt-5 font-display text-[clamp(1.75rem,2.6vw,2.5rem)] leading-[1.12] font-[550] text-balance text-ink-900">
                {chapter.title}
              </h3>
              <div class="mt-6 space-y-4 text-base leading-[1.7] text-ink-600 md:text-[1.0625rem] md:leading-[1.75]">
                {chapter.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '../../scripts/scroll-camera';
</script>

<style>
  /*
   * Layout and motion tuning, mobile first. --block-offset is the distance
   * from the stage centre to a chapter's centre when it is being read;
   * --camera-pan is how far the camera swings between chapters.
   */
  .story {
    --block-w: min(84vw, 30rem);
    --block-offset: 3vw;
    --camera-pan: 0.045;
    --plant-w: 72vw;
    --plant-opacity: 0.8;
    --chapter-gap: 30svh;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .story {
      --block-w: 42vw;
      --block-offset: calc(var(--block-w) / 2 + 5vw);
      --camera-pan: 0.08;
      --plant-w: 52vw;
      --plant-opacity: 0.92;
      --chapter-gap: 34svh;
    }
  }

  @media (min-width: 1024px) {
    .story {
      --block-w: min(32vw, 34rem);
      --block-offset: calc(var(--block-w) / 2 + 8vw);
      --camera-pan: 0.13;
      --plant-w: clamp(24rem, 40vw, 46rem);
      --plant-opacity: 1;
      --chapter-gap: 36svh;
    }
  }

  .story-world {
    position: relative;
    padding-block: 34svh 20svh;
  }

  .story-plant {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .story-chapters {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--chapter-gap);
  }

  .story-chapter {
    width: var(--block-w);
    margin-left: calc(50% - var(--block-offset) - var(--block-w) / 2);
    transform-origin: 50% 40%;
  }

  .story-chapter[data-side='right'] {
    margin-left: calc(50% + var(--block-offset) - var(--block-w) / 2);
  }

  /*
   * Below lg the text shares the centre line with the plant. A backdrop in the
   * section colour, feathered by a same-colour shadow, lets the stem pass
   * behind each chapter and show only in the margins and between chapters.
   */
  @media (max-width: 1023.98px) {
    .story-chapter {
      background: var(--color-cream-100);
      box-shadow: 0 0 1.5rem 1.25rem var(--color-cream-100);
    }
  }

  /* ── Camera mode (set by the script once it has taken over) ──────── */

  .story.is-camera .story-stage {
    position: relative;
    height: 100svh;
    /* clip, not hidden: nothing may scroll this box, including find-in-page. */
    overflow: clip;
  }

  .story.is-camera .story-world {
    position: absolute;
    inset: 0 0 auto;
    /* Room for the opening shot (flower) and the closing one (fruit). */
    padding-block: 60svh 55svh;
    will-change: transform;
  }

  .story.is-camera .story-plant {
    will-change: transform;
  }

  .story.is-camera .story-chapter {
    will-change: transform, opacity;
  }
</style>
