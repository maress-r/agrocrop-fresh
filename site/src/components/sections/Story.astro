---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import { getDictionary, type Locale } from '../../i18n';

import seedlingHand from '../../assets/photos/seedling-hand.jpg';
import greenhouseRows from '../../assets/photos/greenhouse-rows.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="story" class="section-pad bg-cream-50">
  <div class="container-site">
    <SectionHead
      number="01"
      kicker={t.story.kicker}
      title={t.story.title}
      lede={t.story.lede}
    />

    <div class="mt-16 grid gap-14 md:mt-24 lg:grid-cols-[1fr_1.15fr] lg:gap-24">
      <!-- Imagery column -->
      <div class="relative order-2 lg:order-1">
        <div class="flex flex-col gap-6 lg:sticky lg:top-32">
          <figure class="overflow-hidden rounded-2xl" data-reveal>
            <Image
              src={seedlingHand}
              alt={locale === 'sr'
                ? 'Rasad paprike u ruci, staklenik u pozadini'
                : 'Pepper seedling held in hand, greenhouse in the background'}
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 42vw, 92vw"
              class="aspect-[4/5] w-full scale-[1.06] object-cover md:aspect-[3/4]"
              data-parallax="4"
            />
          </figure>
          <figure class="hidden overflow-hidden rounded-2xl lg:block" data-reveal>
            <Image
              src={greenhouseRows}
              alt={locale === 'sr'
                ? 'Redovi paprike u savremenom plasteniku'
                : 'Rows of peppers inside a modern greenhouse'}
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 42vw, 92vw"
              class="aspect-[16/10] w-full scale-[1.06] object-cover"
              data-parallax="4"
            />
          </figure>
        </div>
      </div>

      <!-- Timeline -->
      <ol class="relative order-1 flex flex-col lg:order-2" data-reveal-group>
        {
          t.story.timeline.map((entry, i) => (
            <li
              class:list={[
                'relative border-l border-ink-900/12 pt-2 pl-10 md:pl-14',
                i === t.story.timeline.length - 1 ? 'pb-2' : 'pb-14 md:pb-18',
              ]}
            >
              <span
                class="absolute top-3 -left-[5px] h-[9px] w-[9px] rounded-full bg-ember-500"
                aria-hidden="true"
              />
              <p class="font-display text-[2rem] leading-none font-[560] text-ember-600 md:text-[2.5rem]">
                {entry.year}
              </p>
              <h3 class="mt-4 font-display text-display-md font-[550] text-ink-900">
                {entry.title}
              </h3>
              <p class="mt-3 max-w-xl text-[1.0625rem] leading-relaxed text-ink-600">
                {entry.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
