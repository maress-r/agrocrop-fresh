---
/**
 * Realistic pepper plant — one continuous plant: flower at the top, leafy
 * growth down the stem, fruit ripening green → yellow → red toward the bottom.
 *
 * Pure SVG, so it stays sharp at any size: form comes from gradient shading
 * (a rounded stem, leaves folded along the midrib, glossy lobed fruit), detail
 * from computed venation, depth from a soft drop shadow. Light falls from the
 * upper left on every part; mirrored parts un-mirror their fruit to keep it so.
 *
 * The stem is one stretched SVG spanning its container; everything attached to
 * it (leaves, twigs, fruit, flower) is a separate fixed-proportion SVG pinned
 * to a point on the same curve, so nothing distorts at any height.
 *
 * Motion hooks (driven by scripts/scroll-camera.ts, inert without it):
 *   [data-camera-draw]  the stem, revealed top-down
 *   [data-camera-grow]  each part, grows in through --p (0 → 1)
 *
 * Sizing comes from the parent: --plant-w (width) and --plant-opacity.
 */

type Pt = readonly [number, number];
type Bez = readonly [Pt, Pt, Pt, Pt];
type Tone = 'cream' | 'lemon' | 'red' | 'green';

/* ── Geometry helpers ─────────────────────────────────────────────── */

const f1 = (n: number) => String(Math.round(n * 10) / 10);
const f2 = (n: number) => String(Math.round(n * 100) / 100);
const pt = (p: Pt, fmt = f1) => `${fmt(p[0])} ${fmt(p[1])}`;

/** Point and unit normal on a cubic Bézier; the normal is the tangent turned +90°. */
function onCurve(c: Bez, t: number) {
  const [a, b, d, e] = c;
  const u = 1 - t;
  const x = u * u * u * a[0] + 3 * u * u * t * b[0] + 3 * u * t * t * d[0] + t * t * t * e[0];
  const y = u * u * u * a[1] + 3 * u * u * t * b[1] + 3 * u * t * t * d[1] + t * t * t * e[1];
  const dx = 3 * u * u * (b[0] - a[0]) + 6 * u * t * (d[0] - b[0]) + 3 * t * t * (e[0] - d[0]);
  const dy = 3 * u * u * (b[1] - a[1]) + 6 * u * t * (d[1] - b[1]) + 3 * t * t * (e[1] - d[1]);
  const len = Math.hypot(dx, dy) || 1;
  return { p: [x, y] as Pt, n: [-dy / len, dx / len] as Pt };
}

/** Smooth open run through points (Catmull-Rom as cubic Béziers), without the leading M. */
function through(pts: Pt[], fmt = f1): string {
  let d = '';
  const n = pts.length;
  for (let i = 0; i < n - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(n - 1, i + 2)];
    const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${pt(c1, fmt)} ${pt(c2, fmt)} ${pt(p2, fmt)}`;
  }
  return d;
}

/** Closed shape between two edges that run the same way. */
function ribbon(a: Pt[], b: Pt[], fmt = f1): string {
  const rb = [...b].reverse();
  return `M${pt(a[0], fmt)}${through(a, fmt)}L${pt(rb[0], fmt)}${through(rb, fmt)}Z`;
}

/** Band across a tapered curve, between fractions s0..s1 of its half-width. */
function band(
  c: Bez,
  hw: (t: number) => number,
  s0: number,
  s1: number,
  steps = 14,
  t0 = 0,
  t1 = 1
): string {
  const a: Pt[] = [];
  const b: Pt[] = [];
  for (let i = 0; i <= steps; i++) {
    const t = t0 + ((t1 - t0) * i) / steps;
    const { p, n } = onCurve(c, t);
    const w = hw(t);
    a.push([p[0] + n[0] * s0 * w, p[1] + n[1] * s0 * w]);
    b.push([p[0] + n[0] * s1 * w, p[1] + n[1] * s1 * w]);
  }
  return ribbon(a, b);
}

type Stop = readonly [number, string, number?];
const stops = (s: readonly Stop[]) =>
  s
    .map(
      ([o, c, a = 1]) =>
        `<stop offset="${o}" stop-color="${c}"${a < 1 ? ` stop-opacity="${a}"` : ''}/>`
    )
    .join('');
const linear = (id: string, dir: 'x' | 'y', s: readonly Stop[]) =>
  `<linearGradient id="${id}" x1="0" y1="0" x2="${dir === 'x' ? 1 : 0}" y2="${dir === 'y' ? 1 : 0}">${stops(s)}</linearGradient>`;
const radial = (id: string, attrs: string, s: readonly Stop[]) =>
  `<radialGradient id="${id}" ${attrs}>${stops(s)}</radialGradient>`;

/* ── Stem ─────────────────────────────────────────────────────────── */

/** Stem centre-line in stem-viewBox units (x: 0–100 of width, y: 0–1000 of height). */
const stemX = (t: number) =>
  50 + 4.2 * Math.sin(2 * Math.PI * 1.35 * t + 0.9) + 1.5 * Math.sin(2 * Math.PI * 3.1 * t + 2.2);
/** Stem half-width in the same x-units: slender and green at the top, woody below. */
const stemHW = (t: number) => 0.55 + 0.9 * Math.pow(t, 0.85);

function stemBand(s0: number, s1: number, steps = 56): string {
  const a: Pt[] = [];
  const b: Pt[] = [];
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const x = stemX(t);
    const w = stemHW(t);
    a.push([x + s0 * w, t * 1000]);
    b.push([x + s1 * w, t * 1000]);
  }
  return ribbon(a, b, f2);
}
const stem = {
  body: stemBand(-1, 1),
  light: stemBand(-0.62, -0.16),
  shadow: stemBand(0.3, 1),
};

/* ── Leaves ───────────────────────────────────────────────────────── */

const RIB: Bez = [
  [9, -0.5],
  [35, -8.5],
  [67, -9.5],
  [97, -3],
];
/** Ovate-lanceolate outline, widest about a third of the way out. */
const leafShape = (t: number) => {
  const a = 0.58;
  const b = 1;
  const peak = Math.pow(a / (a + b), a) * Math.pow(b / (a + b), b);
  return (Math.pow(t, a) * Math.pow(1 - t, b)) / peak;
};
const hwUp = (t: number) => 20 * leafShape(t) * (1 + 0.035 * Math.sin(t * 23));
const hwLo = (t: number) => 17 * leafShape(t) * (1 + 0.035 * Math.sin(t * 19 + 1.3));

const ribPts: Pt[] = [];
const upPts: Pt[] = [];
const loPts: Pt[] = [];
for (let i = 0; i <= 22; i++) {
  const t = i / 22;
  const { p, n } = onCurve(RIB, t);
  ribPts.push(p);
  upPts.push([p[0] - n[0] * hwUp(t), p[1] - n[1] * hwUp(t)]);
  loPts.push([p[0] + n[0] * hwLo(t), p[1] + n[1] * hwLo(t)]);
}

/** Secondary veins arc forward from the midrib and loop just inside the margin. */
function veins(side: -1 | 1) {
  const hw = side < 0 ? hwUp : hwLo;
  const ends: Pt[] = [];
  const paths: string[] = [];
  for (let i = 0; i < 7; i++) {
    const t = 0.11 + i * 0.117 + (side > 0 ? 0.055 : 0);
    if (t > 0.88) break;
    const s = onCurve(RIB, t);
    const te = Math.min(t + 0.12, 0.96);
    const e = onCurve(RIB, te);
    const c = onCurve(RIB, t + 0.035);
    const E: Pt = [e.p[0] + side * e.n[0] * hw(te) * 0.86, e.p[1] + side * e.n[1] * hw(te) * 0.86];
    const C: Pt = [c.p[0] + side * c.n[0] * hw(t) * 0.5, c.p[1] + side * c.n[1] * hw(t) * 0.5];
    paths.push(
      `<path d="M${pt(s.p)}Q${pt(C)} ${pt(E)}" stroke-width="${f2(0.62 - 0.36 * t)}"/>`
    );
    ends.push(E);
  }
  const loops = ends.slice(0, -1).map((E, i) => {
    const N = ends[i + 1];
    const m = onCurve(RIB, 0.2 + i * 0.117);
    const M: Pt = [(E[0] + N[0]) / 2 + side * m.n[0] * 1.6, (E[1] + N[1]) / 2 + side * m.n[1] * 1.6];
    return `<path d="M${pt(E)}Q${pt(M)} ${pt(N)}"/>`;
  });
  return { paths: paths.join(''), loops: loops.join('') };
}
const veinsUp = veins(-1);
const veinsLo = veins(1);

const leaf = {
  petiole: band(
    [
      [0, 0],
      [3, -0.2],
      [6, -0.4],
      [9, -0.5],
    ],
    (t) => 1.15 - 0.3 * t,
    -1,
    1,
    6
  ),
  upper: ribbon(upPts, ribPts),
  lower: ribbon(ribPts, loPts),
  outline: ribbon(upPts, loPts),
  midrib: band(RIB, (t) => 0.95 - 0.8 * t, -1, 1, 16),
  gloss: band(RIB, hwUp, -0.8, -0.24, 12, 0.12, 0.82),
};

const LEAF_TONES = {
  sun: {
    up: ['#3a5e22', '#548235', '#78a04b'],
    lo: ['#28461a', '#3a6127', '#517a35'],
    rib: '#c2d69a',
    vein: '#b6cd8a',
    edge: '#1b3011',
    gloss: 1,
  },
  shade: {
    up: ['#2c4b1b', '#3e6528', '#56803a'],
    lo: ['#1e3614', '#2c4c1e', '#3d6329'],
    rib: '#9fb77b',
    vein: '#93ad6e',
    edge: '#152509',
    gloss: 0.45,
  },
} as const;

function leafGroup(tone: keyof typeof LEAF_TONES): string {
  const T = LEAF_TONES[tone];
  const id = `pp-leaf-${tone}`;
  return `<g id="${id}">
    <path d="${leaf.petiole}" fill="url(#pp-stalk)"/>
    <path d="${leaf.upper}" fill="url(#${id}-up)"/>
    <path d="${leaf.lower}" fill="url(#${id}-lo)"/>
    <path d="${leaf.gloss}" fill="url(#pp-gloss)" opacity="${T.gloss}"/>
    <g fill="none" stroke="${T.vein}" stroke-linecap="round" opacity="0.55">${veinsUp.paths}${veinsLo.paths}</g>
    <g fill="none" stroke="${T.vein}" stroke-width="0.28" stroke-linecap="round" opacity="0.3">${veinsUp.loops}${veinsLo.loops}</g>
    <path d="${leaf.midrib}" fill="${T.rib}"/>
    <path d="${leaf.outline}" fill="none" stroke="${T.edge}" stroke-width="0.35" stroke-opacity="0.6"/>
  </g>`;
}

/* ── Fruit ────────────────────────────────────────────────────────── */

const FRUIT: Record<Tone, { hi: string; light: string; base: string; shade: string; deep: string; rim: string }> = {
  cream: { hi: '#fffbe6', light: '#f8efbe', base: '#eadb91', shade: '#c9b35d', deep: '#8f7a30', rim: '#f5e9b2' },
  lemon: { hi: '#fdfbe0', light: '#f3efb8', base: '#e1d884', shade: '#b8ac4c', deep: '#7f7626', rim: '#efe8a6' },
  red: { hi: '#ffe4da', light: '#e2644a', base: '#c1321f', shade: '#8a1d10', deep: '#561006', rim: '#dc5a3e' },
  green: { hi: '#eef6d8', light: '#93ba5d', base: '#63903a', shade: '#3f6522', deep: '#243f12', rim: '#8ab356' },
};

/** Peduncle for a hanging fruit: thickens toward the calyx, lit on its left. */
function peduncle(c: Bez, w0: number, w1: number) {
  const hw = (t: number) => w0 + (w1 - w0) * t;
  // Runs downward, so the normal points left: positive s is the lit side.
  return `<path d="${band(c, hw, -1, 1, 8)}" fill="url(#pp-stalk-v)"/>
    <path d="${band(c, hw, 0.2, 0.72, 8, 0.05, 0.95)}" fill="#c2d69a" opacity="0.5"/>`;
}

/** Babura: blocky four-lobed bell, glossy, hanging from its node at (0, 0). */
const BABURA = {
  body: 'M4.5 13C12 12 18.5 15.5 18.8 23C19.2 31 18 39 15 44C13.5 46.5 10.8 47 9.2 45.6C8 46.8 6 47.4 4.5 46.4C3 47.4 1 46.8 -0.2 45.6C-1.8 47 -4.5 46.5 -6 44C-9 39 -10.2 31 -9.8 23C-9.5 15.5 -3 12 4.5 13Z',
  grooveL: 'M-0.4 15.5C-2.6 23 -2.8 34 -0.9 45.2C0.6 34 1.2 23 -0.4 15.5Z',
  grooveR: 'M9.4 15.5C8 23 8.2 34 9.6 45.2C11.6 34 11.8 23 9.4 15.5Z',
  lobeL: 'M-5 16C-7.6 24 -7.8 34 -5.6 42C-3.8 34 -3.4 24 -5 16Z',
  lobeC: 'M4.4 15C2.8 24 2.8 35 4.2 44C6 35 6.2 24 4.4 15Z',
  lobeR: 'M14.2 17C12.6 25 12.6 34 13.8 41C15.6 34 16 25 14.2 17Z',
  rim: 'M17.6 20C18.6 27 18.2 36 15.6 42.6C17.4 36 17.6 27 16.4 20.4Z',
  specL: 'M-4.2 17.5C-5.4 21 -5.6 27 -4.8 32C-3.6 27 -3.4 21 -4.2 17.5Z',
  specC: 'M2.8 17C2.2 20 2.1 24 2.5 27C3.2 24 3.4 20 2.8 17Z',
  cup: 'M-1 13.6C-0.4 11.4 9.4 11.4 10 13.6C9 15.4 0 15.4 -1 13.6Z',
  sepals:
    'M-0.6 13.4C-3.4 13.6 -5.6 15 -6.8 16.8C-4.6 16 -2.2 15.4 0.2 14.8ZM9.6 13.4C12.4 13.6 14.6 15 15.8 16.8C13.6 16 11.2 15.4 8.8 14.8ZM1.8 14.6C0.6 15.8 -0.2 17.2 -0.4 18.6C1 17.4 2.2 16.4 3.4 15.4ZM7.2 14.6C8.4 15.8 9.2 17.2 9.4 18.6C8 17.4 6.8 16.4 5.6 15.4ZM4.5 15C4.2 16.4 4.2 17.8 4.5 19C4.8 17.8 4.8 16.4 4.5 15Z',
};

function baburaGroup(tone: Tone): string {
  const F = FRUIT[tone];
  return `<g id="pp-babura-${tone}">
    ${peduncle([[0, 0], [3, 2.5], [5, 6], [4.5, 11.5]], 0.95, 1.55)}
    <path d="${BABURA.body}" fill="url(#pp-bb-${tone})"/>
    <path d="${BABURA.grooveL}" fill="url(#pp-groove-${tone})"/>
    <path d="${BABURA.grooveR}" fill="url(#pp-groove-${tone})"/>
    <path d="${BABURA.lobeL}" fill="url(#pp-lobe-${tone})" opacity="0.8"/>
    <path d="${BABURA.lobeC}" fill="url(#pp-lobe-${tone})" opacity="0.45"/>
    <path d="${BABURA.lobeR}" fill="url(#pp-lobe-${tone})" opacity="0.22"/>
    <path d="${BABURA.rim}" fill="${F.rim}" opacity="0.5"/>
    <ellipse cx="4.5" cy="15.6" rx="8.4" ry="2.8" fill="url(#pp-shoulder-${tone})"/>
    <path d="${BABURA.specL}" fill="url(#pp-spec)"/>
    <path d="${BABURA.specC}" fill="url(#pp-spec)" opacity="0.55"/>
    <ellipse cx="-3.7" cy="18" rx="1.5" ry="1" fill="#fff" opacity="0.85"/>
    <path d="${BABURA.body}" fill="none" stroke="${F.deep}" stroke-width="0.35" stroke-opacity="0.45"/>
    <path d="${BABURA.sepals}" fill="url(#pp-calyx)"/>
    <path d="${BABURA.cup}" fill="url(#pp-calyx)"/>
  </g>`;
}

/** Šilja: long tapering cone with a soft ridge, glossy, hanging from (0, 0). */
const SILJA = {
  body: 'M3.4 11.8C8 11.2 10.4 14 10.2 19C10 27 9.4 35 8.2 42C7.4 47 6.4 51.5 5.4 54C4.9 55 4.3 54.8 4.1 53.8C3 49.5 1.2 44 -0.6 37C-2.3 30 -3.6 23 -3.4 18.5C-3.3 13.8 -0.8 11.9 3.4 11.8Z',
  ridge: 'M5.2 14C6.6 24 6.6 36 5.6 49C4.6 36 4.4 24 5.2 14Z',
  spec: 'M0.2 15C-1.2 21 -1.2 30 0.4 38C1.6 30 1.8 21 0.2 15Z',
  rim: 'M9.2 18C9.4 26 8.8 34 7.4 41C8.8 34 9.8 26 9.8 19Z',
  cup: 'M-1.2 12.2C-0.6 10.2 7.4 10.2 8 12.2C7 13.8 -0.2 13.8 -1.2 12.2Z',
  sepals:
    'M-0.8 12C-3 12.2 -4.6 13.4 -5.4 14.8C-3.6 14.2 -1.8 13.8 0 13.4ZM7.6 12C9.8 12.2 11.4 13.4 12.2 14.8C10.4 14.2 8.6 13.8 6.8 13.4ZM2 13C1.2 14 0.8 15.2 0.8 16.4C1.8 15.4 2.6 14.6 3.4 13.8ZM4.8 13C5.6 14 6 15.2 6 16.4C5 15.4 4.2 14.6 3.4 13.8Z',
};

function siljaGroup(tone: Tone): string {
  const F = FRUIT[tone];
  return `<g id="pp-silja-${tone}">
    ${peduncle([[0, 0], [2.6, 2.4], [4, 6], [3.4, 10.6]], 0.85, 1.3)}
    <path d="${SILJA.body}" fill="url(#pp-sb-${tone})"/>
    <path d="${SILJA.body}" fill="url(#pp-stip-${tone})"/>
    <path d="${SILJA.ridge}" fill="url(#pp-groove-${tone})" opacity="0.7"/>
    <path d="${SILJA.rim}" fill="${F.rim}" opacity="0.45"/>
    <ellipse cx="3.4" cy="14" rx="6" ry="2" fill="url(#pp-shoulder-${tone})"/>
    <path d="${SILJA.spec}" fill="url(#pp-spec)"/>
    <ellipse cx="0.4" cy="15.6" rx="1.2" ry="0.85" fill="#fff" opacity="0.85"/>
    <path d="${SILJA.body}" fill="none" stroke="${F.deep}" stroke-width="0.32" stroke-opacity="0.45"/>
    <path d="${SILJA.sepals}" fill="url(#pp-calyx)"/>
    <path d="${SILJA.cup}" fill="url(#pp-calyx)"/>
  </g>`;
}

/** Closed flower bud, hanging from (0, 0). */
const budGroup = `<g id="pp-bud">
  ${peduncle([[0, 0], [1.5, 2.5], [3, 5], [3, 8.4]], 0.6, 0.75)}
  <path d="M3 8.2C5.9 8.4 7.2 11.4 6.6 14.4C6 17.2 4.4 19.2 3 19.2C1.6 19.2 0 17.2 -0.6 14.4C-1.2 11.4 0.1 8.4 3 8.2Z" fill="url(#pp-bud-body)"/>
  <path d="M3 10.6C2.4 13 2.4 16 3 18.6M1 11.4C0.4 13.6 0.6 16 1.4 17.8M5 11.4C5.6 13.6 5.4 16 4.6 17.8" fill="none" stroke="#a8b884" stroke-width="0.22" opacity="0.7"/>
  <ellipse cx="1.4" cy="12.2" rx="0.9" ry="1.6" fill="#fff" opacity="0.5"/>
  <path d="M-0.4 10.8C0.2 9 1.6 8.2 3 8.2C4.4 8.2 5.8 9 6.4 10.8C5.2 10 4.2 9.8 3 10.4C1.8 9.8 0.8 10 -0.4 10.8Z" fill="url(#pp-calyx)"/>
</g>`;

/* ── Flower ───────────────────────────────────────────────────────── */

const FC: Pt = [0, -35];
const SY = 0.82; // foreshortening: the flower tilts slightly toward the viewer
const place = (p: Pt, a: number): Pt => {
  const x = p[0] * Math.cos(a) - p[1] * Math.sin(a);
  const y = p[0] * Math.sin(a) + p[1] * Math.cos(a);
  return [FC[0] + x, FC[1] + SY * y];
};
const PETAL_PROFILE: [number, number][] = [
  [2, 1.2],
  [6, 4.6],
  [10, 5.8],
  [14, 5],
  [17.5, 3],
  [20.5, 0],
];
const petalAngles = Array.from({ length: 6 }, (_, i) => -Math.PI / 2 + (i * Math.PI) / 3 + 0.2);
const petals = petalAngles
  .map((a) => {
    const upper = PETAL_PROFILE.map(([r, w]) => place([r, -w], a));
    const lower = PETAL_PROFILE.map(([r, w]) => place([r, w], a));
    const veinsD = [
      `M${pt(place([3, 0], a))}L${pt(place([16, 0], a))}`,
      `M${pt(place([4, -0.6], a))}Q${pt(place([9, -2.6], a))} ${pt(place([13.5, -3.2], a))}`,
      `M${pt(place([4, 0.6], a))}Q${pt(place([9, 2.6], a))} ${pt(place([13.5, 3.2], a))}`,
    ].join('');
    // Light from the upper left: petals facing lower right sit in shade.
    const shade = Math.max(0, Math.cos(a - Math.PI / 4)) * 0.22;
    return { a, d: ribbon(upper, lower), veinsD, shade };
  })
  .sort((p, q) => Math.sin(p.a) - Math.sin(q.a)); // far (upper) petals first

const anthers = petalAngles.map((a) => {
  const b = a + Math.PI / 6;
  const c = place([5.4, 0], b);
  const deg = (Math.atan2(Math.sin(b) * SY, Math.cos(b)) * 180) / Math.PI;
  return `<ellipse cx="${f1(c[0])}" cy="${f1(c[1])}" rx="2.5" ry="1.3" transform="rotate(${f1(deg)} ${f1(c[0])} ${f1(c[1])})" fill="url(#pp-anther)"/>`;
});

const flowerSvg = `
  <path d="${band([[0, 0], [1.5, -8], [-1.5, -16], [0, -23.5]], (t) => 1.45 - 0.5 * t, -1, 1, 10)}" fill="url(#pp-stalk-v)"/>
  <use href="#pp-bud" transform="translate(0 -6) rotate(140) scale(0.95)"/>
  <use href="#pp-bud" transform="translate(0 -11) rotate(-140) scale(0.85)"/>
  <path d="M-5.5 -24.5C-5 -27.5 5 -27.5 5.5 -24.5C4 -22.6 -4 -22.6 -5.5 -24.5Z" fill="url(#pp-calyx)"/>
  <path d="M-5 -24.4L-8.2 -21.6L-3.6 -23.2ZM5 -24.4L8.2 -21.6L3.6 -23.2ZM-1.6 -23.4L-2.6 -19.8L0.2 -22.8ZM1.6 -23.4L2.6 -19.8L-0.2 -22.8Z" fill="url(#pp-calyx)"/>
  ${petals
    .map(
      (p) => `<path d="${p.d}" fill="url(#pp-petal)"/>
    ${p.shade > 0.01 ? `<path d="${p.d}" fill="#aeb198" opacity="${f2(p.shade)}"/>` : ''}
    <path d="${p.veinsD}" fill="none" stroke="#d9dcc4" stroke-width="0.28" stroke-linecap="round"/>
    <path d="${p.d}" fill="none" stroke="#c8cbb3" stroke-width="0.3"/>`
    )
    .join('')}
  <circle cx="${FC[0]}" cy="${FC[1]}" r="3.4" fill="url(#pp-ovary)"/>
  ${anthers.join('')}
  <circle cx="${FC[0]}" cy="${FC[1] - 0.4}" r="1" fill="#eef3bf"/>
`;

/* ── Shared paint (gradients) ─────────────────────────────────────── */

const gradients = [
  linear('pp-stem', 'y', [
    [0, '#6f9a45'],
    [0.3, '#588439'],
    [0.65, '#4a7232'],
    [1, '#50602f'],
  ]),
  linear('pp-stem-light', 'y', [
    [0, '#c3dc98', 0.62],
    [1, '#a4b67c', 0.3],
  ]),
  linear('pp-stalk', 'y', [
    [0, '#86ad58'],
    [0.5, '#557f35'],
    [1, '#2f5020'],
  ]),
  linear('pp-stalk-v', 'x', [
    [0, '#86ad58'],
    [0.5, '#557f35'],
    [1, '#2f5020'],
  ]),
  radial('pp-joint', 'cx="0.38" cy="0.35" r="0.7"', [
    [0, '#8fb562'],
    [0.6, '#557f35'],
    [1, '#35561f'],
  ]),
  radial('pp-calyx', 'cx="0.4" cy="0.3" r="0.85"', [
    [0, '#8db35c'],
    [0.55, '#58813a'],
    [1, '#2f5020'],
  ]),
  radial('pp-gloss', 'cx="0.45" cy="0.5" r="0.55"', [
    [0, '#ffffff', 0.32],
    [0.55, '#ffffff', 0.12],
    [1, '#ffffff', 0],
  ]),
  linear('pp-spec', 'y', [
    [0, '#ffffff', 0.95],
    [0.5, '#ffffff', 0.5],
    [1, '#ffffff', 0],
  ]),
  radial('pp-bud-body', 'cx="0.38" cy="0.6" r="0.75"', [
    [0, '#f3f6e2'],
    [0.5, '#d2dcaa'],
    [1, '#8ea466'],
  ]),
  radial('pp-petal', `gradientUnits="userSpaceOnUse" cx="${FC[0]}" cy="${FC[1]}" r="21"`, [
    [0, '#d6e0a6'],
    [0.18, '#eef1d5'],
    [0.5, '#fefdf7'],
    [0.85, '#fbf9ef'],
    [1, '#efede0'],
  ]),
  radial('pp-ovary', 'cx="0.4" cy="0.35" r="0.7"', [
    [0, '#eef2b8'],
    [0.55, '#b9c55f'],
    [1, '#8a9a3e'],
  ]),
  linear('pp-anther', 'x', [
    [0, '#a3a1d6'],
    [0.5, '#6b68a9'],
    [1, '#45427d'],
  ]),
  ...(['sun', 'shade'] as const).flatMap((tone) => {
    const T = LEAF_TONES[tone];
    return [
      linear(`pp-leaf-${tone}-up`, 'x', [
        [0, T.up[0]],
        [0.55, T.up[1]],
        [1, T.up[2]],
      ]),
      linear(`pp-leaf-${tone}-lo`, 'x', [
        [0, T.lo[0]],
        [0.55, T.lo[1]],
        [1, T.lo[2]],
      ]),
    ];
  }),
  ...(Object.keys(FRUIT) as Tone[]).flatMap((tone) => {
    const F = FRUIT[tone];
    return [
      radial(`pp-bb-${tone}`, 'cx="0.36" cy="0.3" r="0.82" fx="0.32" fy="0.26"', [
        [0, F.light],
        [0.4, F.base],
        [0.8, F.shade],
        [1, F.deep],
      ]),
      linear(`pp-sb-${tone}`, 'x', [
        [0, F.shade],
        [0.26, F.light],
        [0.5, F.base],
        [0.82, F.shade],
        [1, F.deep],
      ]),
      linear(`pp-stip-${tone}`, 'y', [
        [0, F.deep, 0],
        [0.62, F.deep, 0],
        [1, F.deep, 0.45],
      ]),
      linear(`pp-groove-${tone}`, 'x', [
        [0, F.deep, 0],
        [0.5, F.deep, 0.55],
        [1, F.deep, 0],
      ]),
      linear(`pp-lobe-${tone}`, 'x', [
        [0, F.hi, 0],
        [0.5, F.hi, 0.7],
        [1, F.hi, 0],
      ]),
      radial(`pp-shoulder-${tone}`, 'cx="0.5" cy="0.5" r="0.5"', [
        [0, F.deep, 0.5],
        [1, F.deep, 0],
      ]),
    ];
  }),
].join('');

const defs = [
  gradients,
  leafGroup('sun'),
  leafGroup('shade'),
  baburaGroup('cream'),
  baburaGroup('red'),
  siljaGroup('green'),
  siljaGroup('lemon'),
  siljaGroup('red'),
  budGroup,
].join('');

/* ── Parts along the stem ─────────────────────────────────────────── */

type Kind = 'flower' | 'leaf' | 'twig-bud' | 'twig-silja' | 'twig-babura' | 'twig-pair';
interface Part {
  t: number;
  kind: Kind;
  side?: 'left' | 'right';
  rot?: number;
  w: number;
  tone?: Tone;
  tone2?: Tone;
}

/*
 * Top → bottom follows the story: bloom, young growth, first fruit, harvest.
 * Chapters sit left / right / left of the stem, so in each third the fuller
 * growth leans toward the side without text.
 */
const parts: Part[] = [
  { t: 0, kind: 'flower', w: 30 },
  { t: 0.045, kind: 'leaf', side: 'right', rot: -46, w: 24 },
  { t: 0.06, kind: 'leaf', side: 'left', rot: -42, w: 19 },
  { t: 0.11, kind: 'leaf', side: 'right', rot: -30, w: 34 },
  { t: 0.165, kind: 'twig-bud', side: 'left', rot: -18, w: 32 },
  { t: 0.22, kind: 'leaf', side: 'right', rot: -22, w: 40 },
  { t: 0.28, kind: 'leaf', side: 'left', rot: -26, w: 27 },
  { t: 0.335, kind: 'twig-silja', side: 'left', rot: -10, w: 40, tone: 'green' },
  { t: 0.385, kind: 'leaf', side: 'right', rot: -18, w: 32 },
  { t: 0.445, kind: 'leaf', side: 'left', rot: -14, w: 40 },
  { t: 0.5, kind: 'twig-babura', side: 'left', rot: -6, w: 44, tone: 'cream' },
  { t: 0.56, kind: 'leaf', side: 'right', rot: -24, w: 27 },
  { t: 0.615, kind: 'leaf', side: 'left', rot: -16, w: 35 },
  { t: 0.67, kind: 'twig-silja', side: 'right', rot: -8, w: 46, tone: 'lemon' },
  { t: 0.725, kind: 'leaf', side: 'left', rot: -20, w: 29 },
  { t: 0.78, kind: 'twig-pair', side: 'right', rot: -4, w: 50, tone: 'cream', tone2: 'red' },
  { t: 0.835, kind: 'leaf', side: 'left', rot: -18, w: 31 },
  { t: 0.885, kind: 'twig-babura', side: 'right', rot: 2, w: 48, tone: 'red' },
  { t: 0.935, kind: 'leaf', side: 'left', rot: -10, w: 27 },
  { t: 0.972, kind: 'twig-babura', side: 'left', rot: 8, w: 38, tone: 'cream' },
];

/** Fruit is drawn small in its own units; scaled here so a bell hangs about a leaf long. */
const FRUIT_SCALE = 1.8;
const BUD_SCALE = 1.25;

/** Where a twig ends and its leaves / fruit attach, in part-viewBox units. */
const NODE: Pt = [38, -9];
const TWIG: Bez = [[0, 0], [12, -1.5], [25, -5], NODE];

const partStyle = (p: Part) => {
  const isFlower = p.kind === 'flower';
  // Anchor = the point that meets the stem, as fractions of the part's own box.
  const [ax, ay, aspect] = isFlower ? [0.5, 58 / 64, 80 / 64] : [0, 0.5, 1];
  return [
    `--x:${f2(stemX(p.t))}%`,
    `--y:${f2(p.t * 100)}%`,
    `--w:${p.w}%`,
    `--ax:${ax}`,
    `--ay:${f2(ay)}`,
    `--ayw:${f2(ay / aspect)}`,
    `--aspect:${f2(aspect)}`,
    `--rot:${p.rot ?? 0}deg`,
    `--flip:${p.side === 'left' ? -1 : 1}`,
    `--unfurl:${isFlower ? 0 : 34}deg`,
  ].join(';');
};

function partSvg(p: Part): string {
  if (p.kind === 'flower') {
    // A node where the pedicel leaves the stem hides the stem's flat top.
    const jr = stemHW(0) * 1.3 * (80 / p.w);
    return `${flowerSvg}<circle r="${f2(jr)}" fill="url(#pp-joint)"/>`;
  }

  // Sizes that must match the stem are scaled into this part's own units.
  const toPart = 100 / p.w;
  const stemHere = stemHW(p.t) * toPart;
  const joint = `<circle r="${f2(stemHere * 1.3)}" fill="url(#pp-joint)"/>`;
  const flip = p.side === 'left';
  // Fruit and buds hang plumb and keep their light on the left, whatever the part's tilt or side.
  const hang = (at: Pt = NODE, scale = 1) =>
    `translate(${pt(at)}) rotate(${-(p.rot ?? 0)}) scale(${flip ? -scale : scale} ${scale})`;
  const nodeLeaf = (tone: 'sun' | 'shade', deg: number, s: number) =>
    `<use href="#pp-leaf-${tone}" transform="translate(${pt(NODE)}) rotate(${deg}) scale(${s})"/>`;

  if (p.kind === 'leaf') {
    return `<use href="#pp-leaf-shade" transform="rotate(-36) scale(0.6)"/>
      <use href="#pp-leaf-sun"/>${joint}`;
  }

  const twigHW = (t: number) => stemHere * 0.62 * (1 - 0.45 * t);
  const twig = `<path d="${band(TWIG, twigHW, -1, 1, 12)}" fill="url(#pp-stalk)"/>
    <path d="${band(TWIG, twigHW, -0.74, -0.2, 10, 0.04, 0.96)}" fill="#c2d69a" opacity="0.5"/>
    <path d="${band(TWIG, twigHW, 0.3, 1, 10)}" fill="#1d3213" opacity="0.4"/>`;
  const nodeJoint = `<circle cx="${f1(NODE[0])}" cy="${f1(NODE[1])}" r="${f2(stemHere * 0.62 * 0.55 * 1.5)}" fill="url(#pp-joint)"/>`;
  const leaves = {
    'twig-bud': nodeLeaf('shade', -58, 0.38) + nodeLeaf('sun', -24, 0.5),
    'twig-silja': nodeLeaf('shade', -66, 0.42) + nodeLeaf('sun', -34, 0.55),
    'twig-babura': nodeLeaf('shade', -62, 0.4) + nodeLeaf('sun', -30, 0.5),
    'twig-pair': nodeLeaf('shade', -70, 0.42) + nodeLeaf('sun', -40, 0.5),
  }[p.kind];
  const fruit = {
    'twig-bud': `<use href="#pp-bud" transform="${hang(NODE, BUD_SCALE)}"/>`,
    'twig-silja': `<use href="#pp-silja-${p.tone ?? 'lemon'}" transform="${hang(NODE, FRUIT_SCALE)}"/>`,
    'twig-babura': `<use href="#pp-babura-${p.tone ?? 'cream'}" transform="${hang(NODE, FRUIT_SCALE)}"/>`,
    'twig-pair': `<use href="#pp-silja-${p.tone2 ?? 'red'}" transform="${hang([24, -5], FRUIT_SCALE * 0.85)}"/>
      <use href="#pp-babura-${p.tone ?? 'cream'}" transform="${hang(NODE, FRUIT_SCALE)}"/>`,
  }[p.kind];

  return `${twig}${leaves}${nodeJoint}${fruit}${joint}`;
}
---

<div class="pepper-plant" aria-hidden="true">
  {/* Shared paint and geometry. Kept at 0x0 rather than display:none so gradients and <use> resolve everywhere. */}
  <svg class="pp-defs" width="0" height="0" focusable="false">
    <defs set:html={defs}></defs>
  </svg>

  <div class="pp-stem" data-camera-draw>
    <svg viewBox="0 0 100 1000" preserveAspectRatio="none">
      <path d={stem.body} fill="url(#pp-stem)" stroke="#22361a" stroke-opacity="0.5" stroke-width="0.8" vector-effect="non-scaling-stroke"></path>
      <path d={stem.light} fill="url(#pp-stem-light)"></path>
      <path d={stem.shadow} fill="#1d3213" fill-opacity="0.42"></path>
    </svg>
  </div>

  {
    parts.map((p) => (
      <div class="pp-part" style={partStyle(p)} data-camera-grow>
        <svg
          viewBox={p.kind === 'flower' ? '-40 -58 80 64' : '0 -50 100 100'}
          overflow="visible"
          set:html={partSvg(p)}
        ></svg>
      </div>
    ))
  }
</div>

<style>
  .pepper-plant {
    position: absolute;
    top: 28svh;
    bottom: 12svh;
    left: 50%;
    width: var(--plant-w, 30vw);
    margin-left: calc(var(--plant-w, 30vw) / -2);
    opacity: var(--plant-opacity, 1);
    pointer-events: none;
    user-select: none;
  }

  .pp-defs {
    position: absolute;
    overflow: hidden;
  }

  .pp-stem {
    position: absolute;
    inset: 0;
    /* Soft end at the very tip, so the stem never stops dead. */
    mask-image: linear-gradient(to bottom, #000 97.5%, transparent);
  }

  .pp-stem svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /*
   * Each part is pinned by its anchor (where it meets the stem) and turns
   * around that point. --p is growth progress: a part unfurls from close to
   * the stem as it grows, and simply rests at 1 when nothing drives it.
   */
  .pp-part {
    --p: 1;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: var(--aspect);
    /* Percentage margins resolve against container width, same as --w. */
    margin-left: calc(var(--w) * var(--ax) * -1);
    margin-top: calc(var(--w) * var(--ayw) * -1);
    transform-origin: calc(var(--ax) * 100%) calc(var(--ay) * 100%);
    transform: scaleX(var(--flip)) rotate(calc(var(--rot) - (1 - var(--p)) * var(--unfurl)))
      scale(calc(0.62 + 0.38 * var(--p)));
    opacity: var(--p);
  }

  .pp-part svg {
    display: block;
    width: 100%;
    height: 100%;
    /* Soft contact shadow: lifts each part off the page like a botanical plate. */
    filter: drop-shadow(0 0.3rem 0.45rem rgb(28 36 23 / 0.2));
  }
</style>
