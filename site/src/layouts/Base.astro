---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDictionary, htmlLang, alternatePath, type Locale } from '../i18n';
import { site } from '../config/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, '') || site.url;
const ogImage = new URL('/og.jpg', site.url).href;
const alternateUrl = new URL(alternatePath(locale), site.url).href.replace(/\/$/, '') || site.url;
const srUrl = site.url;
const enUrl = new URL('/en', site.url).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.company.brand,
  legalName: site.company.legalName,
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  foundingDate: '2012-01-25',
  taxID: site.company.taxId,
  identifier: site.company.registrationNumber,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.headquarters.street,
    addressLocality: site.address.headquarters.city,
    addressCountry: 'RS',
  },
  contactPoint: site.contacts.map((c) => ({
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: c.phoneHref,
    name: c.name,
  })),
};
---

<!doctype html>
<html lang={htmlLang(locale)} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sr-Latn" href={srUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={srUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#12160f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'sr' ? 'en_US' : 'sr_RS'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Motion gate: set before first paint so reveal styles apply only
         when the animation module will actually run. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
      }
    </script>
  </head>

  <body class="min-h-dvh">
    <a href="#main" class="skip-link">{t.a11y.skipToContent}</a>

    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    transform: translateY(-200%);
    background: var(--color-forest-950);
    color: var(--color-cream-50);
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-size: 0.875rem;
    transition: transform 0.2s var(--ease-out-quart);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
